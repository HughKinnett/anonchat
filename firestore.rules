rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function accountAvailable(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/users/$(uid))
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(uid));
    }

    function accountAvailableAfter(uid) {
      return uid is string
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(uid));
    }

    function featureEnabled(featureName) {
      let settingsPath = /databases/$(database)/documents/siteSettings/features;
      return (featureName == 'registrationsEnabled'
          && exists(settingsPath)
          && get(settingsPath).data.get(featureName, false) == true)
        || (featureName != 'registrationsEnabled'
          && (!exists(settingsPath)
            || get(settingsPath).data.get(featureName, true) == true));
    }

    function accountNotSuspended(profile) {
      return !profile.keys().hasAny(['suspendedUntil'])
        || profile.suspendedUntil <= request.time;
    }

    function hasNoDeletionBarrierAfter(uid) {
      return uid is string
        && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(uid));
    }

    function activeUserAfter() {
      let profile = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn()
        && accountAvailableAfter(request.auth.uid)
        && profile.get('banned', false) != true
        && accountNotSuspended(profile);
    }

    function contentAvailableAfter(documentPath) {
      return existsAfter(/databases/$(database)/documents/$(documentPath))
        && getAfter(/databases/$(database)/documents/$(documentPath)).data
          .get('moderationState', 'visible') != 'hidden'
        && linkedContentAvailableAfter(
          getAfter(/databases/$(database)/documents/$(documentPath)).data
        );
    }

    function linkedContentAvailableAfter(content) {
      return content.keys().hasAny(['authorId', 'originalAuthorId', 'ownerId', 'senderId'])
        && (!content.keys().hasAny(['authorId']) || hasNoDeletionBarrierAfter(content.authorId))
        && (!content.keys().hasAny(['originalAuthorId'])
          || hasNoDeletionBarrierAfter(content.originalAuthorId))
        && (!content.keys().hasAny(['ownerId']) || hasNoDeletionBarrierAfter(content.ownerId))
        && (!content.keys().hasAny(['senderId']) || hasNoDeletionBarrierAfter(content.senderId))
        && (!content.keys().hasAny(['circleId']) || linkedCircleAvailableAfter(content.circleId))
        && (!content.keys().hasAny(['roomId']) || linkedRoomAvailableAfter(content.roomId));
    }

    function votePostAvailableAfter(postCollection, postId) {
      return (postCollection == 'posts'
          && existsAfter(/databases/$(database)/documents/posts/$(postId))
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data
            .get('moderationState', 'visible') != 'hidden'
          && linkedContentAvailableAfter(
            getAfter(/databases/$(database)/documents/posts/$(postId)).data
          ))
        || (postCollection == 'communityPosts'
          && existsAfter(/databases/$(database)/documents/communityPosts/$(postId))
          && getAfter(/databases/$(database)/documents/communityPosts/$(postId)).data
            .get('moderationState', 'visible') != 'hidden'
          && linkedContentAvailableAfter(
            getAfter(/databases/$(database)/documents/communityPosts/$(postId)).data
          ));
    }

    function circleAvailableAfter(circleId) {
      return existsAfter(/databases/$(database)/documents/circles/$(circleId))
        && accountAvailableAfter(getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId);
    }

    function roomAvailableAfter(roomId) {
      return existsAfter(/databases/$(database)/documents/rooms/$(roomId))
        && accountAvailableAfter(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId)
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data
          .get('moderationState', 'visible') != 'hidden'
        && roomIsActive(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data);
    }

    function linkedCircleAvailableAfter(circleId) {
      return existsAfter(/databases/$(database)/documents/circles/$(circleId))
        && hasNoDeletionBarrierAfter(getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId);
    }

    function linkedRoomAvailableAfter(roomId) {
      return existsAfter(/databases/$(database)/documents/rooms/$(roomId))
        && hasNoDeletionBarrierAfter(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId)
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data
          .get('moderationState', 'visible') != 'hidden'
        && roomIsActive(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data);
    }

    function linkedRoomAvailable(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId))
        && hasNoDeletionBarrierAfter(get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId)
        && get(/databases/$(database)/documents/rooms/$(roomId)).data
          .get('moderationState', 'visible') != 'hidden'
        && roomIsActive(get(/databases/$(database)/documents/rooms/$(roomId)).data);
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        && hasMatchingAdminReservation(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        );
    }

    function interestCommunityActiveAfter(communityId) {
      return existsAfter(/databases/$(database)/documents/communities/$(communityId))
        && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.visibility == 'public'
        && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.status == 'active';
    }

    function isInterestCommunityMemberAfter(communityId, uid) {
      return uid is string
        && existsAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(uid))
        && getAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(uid)).data.role
          in ['owner', 'moderator', 'member'];
    }

    function isInterestCommunityOwner(communityId) {
      return signedIn()
        && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function isInterestCommunityModerator(communityId) {
      return signedIn()
        && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role
          in ['owner', 'moderator'];
    }

    function validInterestCommunityPinUpdate() {
      return resource.data.keys().hasAny(['communityId'])
        && isInterestCommunityModerator(resource.data.communityId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedAt', 'pinnedBy'])
        && ((request.resource.data.keys().hasAll(['pinnedAt', 'pinnedBy'])
            && request.resource.data.pinnedAt == request.time
            && request.resource.data.pinnedBy == request.auth.uid)
          || !request.resource.data.keys().hasAny(['pinnedAt', 'pinnedBy']));
    }

    function groupPublicAfter(groupId) {
      return existsAfter(/databases/$(database)/documents/groups/$(groupId))
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public'
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.premiumRequired == false
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.status == 'active';
    }

    function groupActiveAfter(groupId) {
      return existsAfter(/databases/$(database)/documents/groups/$(groupId))
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.status == 'active';
    }

    function isGroupMemberAfter(groupId, uid) {
      return uid is string
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(uid))
        && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.role
          in ['owner', 'moderator', 'member'];
    }

    function isGroupMember(groupId, uid) {
      return uid is string
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid))
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.role
          in ['owner', 'moderator', 'member'];
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && isGroupMember(groupId, request.auth.uid)
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function isGroupModerator(groupId) {
      return signedIn()
        && isGroupMember(groupId, request.auth.uid)
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
          in ['owner', 'moderator'];
    }

    function groupPostReadable() {
      return !resource.data.keys().hasAny(['groupId'])
        || (exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
          && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.visibility == 'public')
        || isGroupMember(resource.data.groupId, request.auth.uid)
        || isAdmin();
    }

    function validGroupPinUpdate() {
      return resource.data.keys().hasAny(['groupId'])
        && isGroupModerator(resource.data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedAt', 'pinnedBy'])
        && ((request.resource.data.keys().hasAll(['pinnedAt', 'pinnedBy'])
            && request.resource.data.pinnedAt == request.time
            && request.resource.data.pinnedBy == request.auth.uid)
          || !request.resource.data.keys().hasAny(['pinnedAt', 'pinnedBy']));
    }

    function validGroupMemberCountUpdate(groupId) {
      let delta = request.resource.data.memberCount - resource.data.memberCount;
      return signedIn()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
        && ((delta == 1
            && ((!exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)))
              || isGroupModerator(groupId)))
          || (delta == -1 && isGroupModerator(groupId))
          || (delta == -1
            && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role != 'owner'
            && !existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))));
    }

    function blockPath(left, right) {
      return /databases/$(database)/documents/blocks/$(left + '_' + right);
    }

    function pairIsBlocked(left, right) {
      return exists(blockPath(left, right)) || exists(blockPath(right, left));
    }

    function mutuallyFollowAfter(left, right) {
      return existsAfter(/databases/$(database)/documents/follows/$(left + '_' + right))
        && existsAfter(/databases/$(database)/documents/follows/$(right + '_' + left));
    }

    function visibleOrAdmin() {
      return isAdmin() || resource.data.get('moderationState', 'visible') != 'hidden';
    }

    function visibleContentOrAdmin(documentPath) {
      return isAdmin()
        || (exists(/databases/$(database)/documents/$(documentPath))
          && get(/databases/$(database)/documents/$(documentPath)).data
            .get('moderationState', 'visible') != 'hidden');
    }

    function votePostVisible(postCollection, postId) {
      return (postCollection == 'posts'
          && exists(/databases/$(database)/documents/posts/$(postId))
          && get(/databases/$(database)/documents/posts/$(postId)).data
            .get('moderationState', 'visible') != 'hidden')
        || (postCollection == 'communityPosts'
          && exists(/databases/$(database)/documents/communityPosts/$(postId))
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data
            .get('moderationState', 'visible') != 'hidden');
    }

    function legacyVoteTargetIsUnambiguous(postId) {
      return (exists(/databases/$(database)/documents/posts/$(postId))
          && !exists(/databases/$(database)/documents/communityPosts/$(postId)))
        || (!exists(/databases/$(database)/documents/posts/$(postId))
          && exists(/databases/$(database)/documents/communityPosts/$(postId)));
    }

    function communityVoteVisibleOrAdmin() {
      return isAdmin()
        || (resource.data.keys().hasAll(['postCollection'])
          && votePostVisible(resource.data.postCollection, resource.data.postId))
        || (!resource.data.keys().hasAny(['postCollection', 'legacyMigrationState'])
          && legacyVoteTargetIsUnambiguous(resource.data.postId)
          && (votePostVisible('posts', resource.data.postId)
            || votePostVisible('communityPosts', resource.data.postId)));
    }

    function roomIsActive(room) {
      return room.expiresAt is timestamp && room.expiresAt > request.time;
    }

    function validRoomExpiry() {
      return request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt >= request.time + duration.value(23, 'h')
          + duration.value(55, 'm')
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')
          + duration.value(5, 'm');
    }

    function validRoomMessageExpiry(roomId) {
      return (getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.keys()
          .hasAny(['expiresAt'])
          && request.resource.data.expiresAt
            == getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.expiresAt)
        || (!getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.keys()
          .hasAny(['expiresAt'])
          && !request.resource.data.keys().hasAny(['expiresAt']));
    }

    function validReportTarget() {
      return (request.resource.data.targetKind == 'post'
          && request.resource.data.targetCollection == 'posts'
          && request.resource.data.targetPath == 'posts/' + request.resource.data.targetId
          && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId))
          && get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.authorId
            == request.resource.data.reportedUserId)
        || (request.resource.data.targetKind == 'communityPost'
          && request.resource.data.targetCollection == 'communityPosts'
          && request.resource.data.targetPath == 'communityPosts/' + request.resource.data.targetId
          && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.targetId))
          && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.targetId)).data.authorId
            == request.resource.data.reportedUserId)
        || (request.resource.data.targetKind == 'room'
          && request.resource.data.targetCollection == 'rooms'
          && request.resource.data.targetPath == 'rooms/' + request.resource.data.targetId
          && exists(/databases/$(database)/documents/rooms/$(request.resource.data.targetId))
          && get(/databases/$(database)/documents/rooms/$(request.resource.data.targetId)).data.ownerId
            == request.resource.data.reportedUserId
          && get(/databases/$(database)/documents/rooms/$(request.resource.data.targetId)).data
            .get('moderationState', 'visible') != 'hidden'
          && get(/databases/$(database)/documents/rooms/$(request.resource.data.targetId)).data
            .get('cleanupState', 'open') != 'closing'
          && roomIsActive(get(/databases/$(database)/documents/rooms/$(request.resource.data.targetId)).data))
        || (request.resource.data.targetKind == 'roomMessage'
          && request.resource.data.targetCollection == 'roomMessages'
          && request.resource.data.targetPath == 'roomMessages/' + request.resource.data.targetId
          && exists(/databases/$(database)/documents/roomMessages/$(request.resource.data.targetId))
          && get(/databases/$(database)/documents/roomMessages/$(request.resource.data.targetId)).data.senderId
            == request.resource.data.reportedUserId
          && exists(/databases/$(database)/documents/rooms/$(get(/databases/$(database)/documents/roomMessages/$(request.resource.data.targetId)).data.roomId))
          && get(/databases/$(database)/documents/rooms/$(get(/databases/$(database)/documents/roomMessages/$(request.resource.data.targetId)).data.roomId)).data.get('cleanupState', 'open') != 'closing')
        || (request.resource.data.targetKind == 'user'
          && request.resource.data.targetCollection == 'users'
          && request.resource.data.targetId == request.resource.data.reportedUserId
          && request.resource.data.targetPath == 'users/' + request.resource.data.targetId
          && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId)));
    }

    function reportReceiptTargetExists(targetKind, targetId) {
      return (targetKind == 'post'
          && exists(/databases/$(database)/documents/posts/$(targetId)))
        || (targetKind == 'communityPost'
          && exists(/databases/$(database)/documents/communityPosts/$(targetId)))
        || (targetKind == 'room'
          && exists(/databases/$(database)/documents/rooms/$(targetId)))
        || (targetKind == 'roomMessage'
          && exists(/databases/$(database)/documents/roomMessages/$(targetId)))
        || (targetKind == 'user'
          && exists(/databases/$(database)/documents/users/$(targetId)));
    }

    function exactReceiptAfterIntake() {
      let receipt = getAfter(/databases/$(database)/documents/reportReceipts/$(request.auth.uid)/$(request.resource.data.targetKind)/$(request.resource.data.targetId));
      return !exists(/databases/$(database)/documents/reportReceipts/$(request.auth.uid)/$(request.resource.data.targetKind)/$(request.resource.data.targetId))
        && existsAfter(/databases/$(database)/documents/reportReceipts/$(request.auth.uid)/$(request.resource.data.targetKind)/$(request.resource.data.targetId))
        && receipt.data.keys().hasOnly(['reporterUid', 'targetKind', 'targetId', 'createdAt'])
        && receipt.data.reporterUid == request.auth.uid
        && receipt.data.targetKind == request.resource.data.targetKind
        && receipt.data.targetId == request.resource.data.targetId
        && receipt.data.createdAt == request.resource.data.createdAt;
    }

    function exactIntakeAfterReceipt(reporterUid, targetKind, targetId) {
      let intake = getAfter(/databases/$(database)/documents/reportIntakes/$(reporterUid + '_' + targetKind + '_' + targetId));
      return !exists(/databases/$(database)/documents/reportIntakes/$(reporterUid + '_' + targetKind + '_' + targetId))
        && existsAfter(/databases/$(database)/documents/reportIntakes/$(reporterUid + '_' + targetKind + '_' + targetId))
        && intake.data.reporterUid == reporterUid
        && intake.data.targetKind == targetKind
        && intake.data.targetId == targetId
        && intake.data.createdAt == request.resource.data.createdAt;
    }

    function exactMaterialHoldAfter(reportId) {
      let kind = request.resource.data.targetKind;
      let targetId = request.resource.data.targetId;
      let postAfter = getAfter(/databases/$(database)/documents/posts/$(targetId));
      let communityAfter = getAfter(/databases/$(database)/documents/communityPosts/$(targetId));
      let roomAfter = getAfter(/databases/$(database)/documents/rooms/$(targetId));
      return (kind == 'post'
          && postAfter.data.get('moderationState', 'visible') == 'hidden'
          && postAfter.data.moderationHoldId == reportId
          && postAfter.data.moderationHeldAt == request.time)
        || (kind == 'communityPost'
          && communityAfter.data.get('moderationState', 'visible') == 'hidden'
          && communityAfter.data.moderationHoldId == reportId
          && communityAfter.data.moderationHeldAt == request.time)
        || (kind == 'room'
          && roomAfter.data.get('moderationState', 'visible') == 'hidden'
          && roomAfter.data.moderationHoldId == reportId
          && roomAfter.data.moderationHeldAt == request.time)
        || kind in ['roomMessage', 'user'];
    }

    function validAdminMaterialRestore() {
      return isAdmin()
        && resource.data.get('moderationState', 'visible') == 'hidden'
        && request.resource.data.get('moderationState', 'visible') == 'visible'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationState']);
    }

    function validModerationHoldUpdate(targetKind, targetId, reportedUserId) {
      let reportId = request.auth.uid + '_' + targetKind + '_' + targetId;
      let intake = getAfter(/databases/$(database)/documents/reportIntakes/$(reportId));
      return activeUserAfter()
        && resource.data.get('moderationState', 'visible') != 'hidden'
        && request.resource.data.get('moderationState', 'visible') == 'hidden'
        && request.resource.data.moderationHoldId == reportId
        && request.resource.data.moderationHeldAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['moderationState', 'moderationHoldId', 'moderationHeldAt'])
        && !exists(/databases/$(database)/documents/reportIntakes/$(reportId))
        && existsAfter(/databases/$(database)/documents/reportIntakes/$(reportId))
        && intake.data.reporterUid == request.auth.uid
        && intake.data.targetKind == targetKind
        && intake.data.targetId == targetId
        && intake.data.reportedUserId == reportedUserId
        && intake.data.createdAt == request.time;
    }

    function validReportIntake(reportId) {
      return request.resource.data.keys().hasOnly([
          'reporterUid', 'targetKind', 'targetCollection', 'targetId', 'targetPath',
          'reportedUserId', 'reason', 'createdAt', 'status'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && !request.resource.data.targetId.matches('.*[/].*')
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId.size() > 0
        && request.resource.data.reporterUid != request.resource.data.reportedUserId
        && reportId == request.auth.uid + '_' + request.resource.data.targetKind + '_'
          + request.resource.data.targetId
        && request.resource.data.targetKind in ['post', 'communityPost', 'room', 'roomMessage', 'user']
        && request.resource.data.reason in [
          'harassment', 'hate-threats', 'sexual-content', 'spam-scam',
          'privacy-impersonation', 'other'
        ]
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'queued'
        && validReportTarget()
        && exactMaterialHoldAfter(reportId);
    }

    function validQueuedModerationAction(caseId) {
      return existsAfter(/databases/$(database)/documents/moderationCases/$(caseId))
        && request.resource.data.keys().hasOnly([
          'action', 'requestedAt', 'requestedBy', 'status'
        ])
        && request.resource.data.action in ['restore', 'deleteMaterial']
        && request.resource.data.requestedAt == request.time
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'queued';
    }

    function validImmediateReportCase(caseId) {
      let intakeId = request.auth.uid + '_' + request.resource.data.targetKind + '_'
        + request.resource.data.targetId;
      let intake = getAfter(/databases/$(database)/documents/reportIntakes/$(intakeId));
      return activeUserAfter()
        && request.resource.data.keys().hasOnly([
          'targetKind', 'targetCollection', 'targetId', 'targetPath', 'reportedUserId',
          'snapshot', 'status', 'reportCount', 'reasonTotals', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.targetKind in ['post', 'communityPost']
        && caseId == request.resource.data.targetKind + '_' + request.resource.data.targetId
        && existsAfter(/databases/$(database)/documents/reportIntakes/$(intakeId))
        && !exists(/databases/$(database)/documents/reportIntakes/$(intakeId))
        && intake.data.reporterUid == request.auth.uid
        && intake.data.targetKind == request.resource.data.targetKind
        && intake.data.targetCollection == request.resource.data.targetCollection
        && intake.data.targetId == request.resource.data.targetId
        && intake.data.reportedUserId == request.resource.data.reportedUserId
        && intake.data.createdAt == request.time
        && request.resource.data.targetPath
          == request.resource.data.targetCollection + '/' + request.resource.data.targetId
        && request.resource.data.snapshot.keys()
          .hasOnly(['kind', 'authorId', 'authorName', 'text'])
        && request.resource.data.snapshot.kind == request.resource.data.targetKind
        && request.resource.data.snapshot.authorId == request.resource.data.reportedUserId
        && request.resource.data.snapshot.authorName is string
        && request.resource.data.snapshot.authorName.size() <= 100
        && request.resource.data.snapshot.text is string
        && request.resource.data.snapshot.text.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.reportCount == 1
        && request.resource.data.reasonTotals.keys().hasOnly([intake.data.reason])
        && request.resource.data.reasonTotals.get(intake.data.reason, 0) == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAdminDeletionCase(caseId) {
      return isAdmin()
        && request.resource.data.keys().hasOnly([
          'targetKind', 'targetCollection', 'targetId', 'targetPath', 'reportedUserId',
          'snapshot', 'status', 'reportCount', 'reasonTotals', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.targetKind in ['post', 'communityPost']
        && caseId == request.resource.data.targetKind + '_' + request.resource.data.targetId
        && request.resource.data.targetCollection == (request.resource.data.targetKind == 'post' ? 'posts' : 'communityPosts')
        && request.resource.data.targetPath == request.resource.data.targetCollection + '/' + request.resource.data.targetId
        && exists(/databases/$(database)/documents/$(request.resource.data.targetCollection)/$(request.resource.data.targetId))
        && get(/databases/$(database)/documents/$(request.resource.data.targetCollection)/$(request.resource.data.targetId)).data.authorId
          == request.resource.data.reportedUserId
        && request.resource.data.snapshot.keys().hasOnly(['kind'])
        && request.resource.data.snapshot.kind == 'queuedAdminDeletion'
        && request.resource.data.status == 'deleteQueued'
        && request.resource.data.reportCount == 0
        && request.resource.data.reasonTotals == {}
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/moderationActions/$(caseId))
        && getAfter(/databases/$(database)/documents/moderationActions/$(caseId)).data.action == 'deleteMaterial'
        && getAfter(/databases/$(database)/documents/moderationActions/$(caseId)).data.requestedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/moderationActions/$(caseId)).data.requestedAt == request.time
        && getAfter(/databases/$(database)/documents/moderationActions/$(caseId)).data.status == 'queued';
    }

    function validTerminalModerationActionRetry(caseId) {
      return exists(/databases/$(database)/documents/moderationCases/$(caseId))
        && resource.data.status in ['failed', 'terminal']
        && resource.data.attempts is int
        && resource.data.attempts >= 8
        && request.resource.data.keys().hasOnly([
          'action', 'requestedAt', 'requestedBy', 'status'
        ])
        && request.resource.data.action == resource.data.action
        && request.resource.data.requestedAt == request.time
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.status == 'queued';
    }

    function validLegacyRoomAction() {
      return request.resource.data.keys().hasOnly([
          'roomId', 'action', 'requestedAt', 'requestedBy', 'status'
        ])
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() > 0
        && !request.resource.data.roomId.matches('.*[/].*')
        && request.resource.data.action in ['retryCleanup', 'approveCleanup', 'release']
        && request.resource.data.requestedAt == request.time
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'queued'
        && exists(/databases/$(database)/documents/legacyRoomQuarantine/$(request.resource.data.roomId))
        && get(/databases/$(database)/documents/legacyRoomQuarantine/$(request.resource.data.roomId)).data.status == 'manualReview';
    }

    function isProtectedAdministrator(username) {
      return username is string
        && username.lower().matches('^[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*(i_love_you_h|cybercapone)[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*$');
    }

    function hasMatchingAdminReservation(profile) {
      let normalizedUsername = profile.username.lower();
      let reservationPath = /databases/$(database)/documents/usernames/$(normalizedUsername);
      return profile.username is string
        && normalizedUsername in ['i_love_you_h', 'cybercapone']
        && exists(reservationPath)
        && get(reservationPath).data.uid == request.auth.uid
        && get(reservationPath).data.username == profile.username;
    }

    function hasNoDeletionQueueState(profile) {
      return !profile.keys().hasAny([
        'adminDeletionRequestedAt', 'adminDeletionRequestedBy', 'adminDeletionStatus'
      ]);
    }

    function matchingDeletionQueueJob(job, targetUid) {
      return job.keys().hasOnly(['targetUid', 'requesterUid', 'requestedAt', 'status'])
        && job.targetUid == targetUid
        && job.requesterUid == request.auth.uid
        && job.requestedAt == request.time
        && job.status == 'queued';
    }

    function matchingSelfDeletionQueueJob(job, targetUid, requestedAt) {
      return job.keys().hasOnly(['targetUid', 'requesterUid', 'requestedAt', 'requestType', 'status'])
        && targetUid == request.auth.uid
        && job.targetUid == targetUid
        && job.requesterUid == targetUid
        && job.requestedAt == requestedAt
        && job.requestType == 'self'
        && job.status == 'queued';
    }

    function validDeletionQueueProfile(userId) {
      return isAdmin()
        && !isProtectedAdministrator(resource.data.username)
        && hasNoDeletionQueueState(resource.data)
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'banned', 'adminDeletionRequestedAt', 'adminDeletionRequestedBy', 'adminDeletionStatus'
        ])
        && request.resource.data.banned == true
        && request.resource.data.adminDeletionRequestedAt == request.time
        && request.resource.data.adminDeletionRequestedBy == request.auth.uid
        && request.resource.data.adminDeletionStatus == 'queued'
        && existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(userId))
        && matchingDeletionQueueJob(
          getAfter(/databases/$(database)/documents/adminDeletionJobs/$(userId)).data,
          userId
        );
    }

    function validStandaloneAdminAccountControl(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid != userId
        && isAdmin()
        && !isProtectedAdministrator(resource.data.username)
        && (
          (changed.hasOnly(['banned'])
            && request.resource.data.banned is bool
            && (request.resource.data.banned == true
              || (hasNoDeletionQueueState(resource.data)
                && !exists(/databases/$(database)/documents/adminDeletionJobs/$(userId)))))
          ||
          (changed.hasOnly(['suspendedUntil'])
            && request.resource.data.suspendedUntil is timestamp)
        );
    }

    function validProfilePrivacyUpdate(userId) {
      let privacy = request.resource.data.profilePrivacy;
      return request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePrivacy'])
        && privacy is map
        && privacy.keys().hasOnly(['showPosts', 'showBadges', 'showFollowersFollowing', 'showActivity'])
        && privacy.keys().hasAll(['showPosts', 'showBadges', 'showFollowersFollowing', 'showActivity'])
        && privacy.showPosts is bool
        && privacy.showBadges is bool
        && privacy.showFollowersFollowing is bool
        && privacy.showActivity is bool;
    }

    function validProfilePinUpdate(userId) {
      let pinnedPostId = request.resource.data.get('pinnedPostId', null);
      return request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedPostId'])
        && (pinnedPostId == null
          || (pinnedPostId is string
            && pinnedPostId.size() > 0
            && pinnedPostId.size() <= 160
            && ((existsAfter(/databases/$(database)/documents/posts/$(request.resource.data.pinnedPostId))
                && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.pinnedPostId)).data.authorId == userId
                && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.pinnedPostId)).data.get('moderationState', 'visible') != 'hidden')
              || (existsAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.pinnedPostId))
                && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.pinnedPostId)).data.authorId == userId
                && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.pinnedPostId)).data.get('moderationState', 'visible') != 'hidden'))));
    }

    function profileBadgesReadable(userId) {
      let profilePath = /databases/$(database)/documents/users/$(userId);
      return signedIn()
        && exists(profilePath)
        && (request.auth.uid == userId
          || isAdmin()
          || get(profilePath).data.get('profilePrivacy', {}).get('showBadges', true) == true);
    }

    function activeUser() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn()
        && accountAvailable(request.auth.uid)
        && profile.get('banned', false) != true
        && accountNotSuspended(profile);
    }

    function isPremiumUid(uid) {
      return exists(/databases/$(database)/documents/premiumAccess/$(uid))
        && get(/databases/$(database)/documents/premiumAccess/$(uid)).data.status == 'active'
        && get(/databases/$(database)/documents/premiumAccess/$(uid)).data.tier in ['founder', 'founding', 'subscriber'];
    }

    function isPremiumUidAfter(uid) {
      return existsAfter(/databases/$(database)/documents/premiumAccess/$(uid))
        && getAfter(/databases/$(database)/documents/premiumAccess/$(uid)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/premiumAccess/$(uid)).data.tier in ['founder', 'founding', 'subscriber'];
    }

    function premiumRoomMember(roomId, uid) {
      return exists(/databases/$(database)/documents/premiumRoomMembers/$(roomId + '_' + uid));
    }

    function premiumRoomMemberAfter(roomId, uid) {
      return existsAfter(/databases/$(database)/documents/premiumRoomMembers/$(roomId + '_' + uid));
    }

    function temporaryRoomMember(roomId, uid) {
      return exists(/databases/$(database)/documents/roomMembers/$(roomId + '_' + uid));
    }

    function temporaryRoomMemberAfter(roomId, uid) {
      return existsAfter(/databases/$(database)/documents/roomMembers/$(roomId + '_' + uid));
    }

    function premiumRoomRole(roomId, uid) {
      return get(/databases/$(database)/documents/premiumRoomMembers/$(roomId + '_' + uid)).data.role;
    }

    function premiumRoomOwner(roomId) {
      return premiumRoomMember(roomId, request.auth.uid)
        && premiumRoomRole(roomId, request.auth.uid) == 'owner';
    }

    function premiumRoomModerator(roomId) {
      return premiumRoomMember(roomId, request.auth.uid)
        && premiumRoomRole(roomId, request.auth.uid) == 'moderator';
    }

    function activePushUser() {
      return activeUser()
        && !exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function activePushUserAfter() {
      return activeUserAfter()
        && !existsAfter(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function selfDeletingPushUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function pushReadDeleteUser() {
      return activePushUser() || selfDeletingPushUser();
    }

    function validPushSubscriptionId(subscriptionId) {
      return subscriptionId.matches('^[0-9a-f]{64}$');
    }

    function validEncryptedEnvelope(envelope, maximumCiphertextSize) {
      return envelope is map
        && envelope.keys().hasOnly(['version', 'algorithm', 'iv', 'ciphertext'])
        && envelope.version == 1
        && envelope.algorithm == 'A256GCM'
        && envelope.iv is string
        && envelope.iv.size() <= 24
        && envelope.ciphertext is string
        && envelope.ciphertext.size() > 0
        && envelope.ciphertext.size() <= maximumCiphertextSize;
    }

    function validPushSubscription() {
      return request.resource.data.keys().hasOnly([
          'uid', 'endpoint', 'expirationTime', 'p256dh', 'auth', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.matches('^https://.*$')
        && request.resource.data.endpoint.size() <= 2048
        && (request.resource.data.expirationTime == null
          || (request.resource.data.expirationTime is int
            && request.resource.data.expirationTime >= 0))
        && request.resource.data.p256dh is string
        && request.resource.data.p256dh.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.p256dh.size() <= 128
        && request.resource.data.auth is string
        && request.resource.data.auth.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.auth.size() <= 64;
    }

    function currentUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function validPhaseBMediaItem(item) {
      return item is map
        && item.keys().hasOnly(['type', 'url'])
        && item.type in ['image', 'gif']
        && item.url is string
        && item.url.size() > 0
        && item.url.size() <= 160000;
    }

    function validPhaseBImage(item) {
      return validPhaseBMediaItem(item) && item.type == 'image';
    }

    function validPhaseBMedia(media) {
      return media is list
        && media.size() <= 4
        && (media.size() == 0
          || (media.size() == 1 && validPhaseBMediaItem(media[0]))
          || (media.size() == 2 && validPhaseBImage(media[0]) && validPhaseBImage(media[1]))
          || (media.size() == 3 && validPhaseBImage(media[0]) && validPhaseBImage(media[1])
            && validPhaseBImage(media[2]))
          || (media.size() == 4 && validPhaseBImage(media[0]) && validPhaseBImage(media[1])
            && validPhaseBImage(media[2]) && validPhaseBImage(media[3])));
    }

    function validPhaseBTopics(topics) {
      return topics is list && topics.size() <= 20;
    }

    function validPhaseBPostEdit() {
      return activeUserAfter()
        && resource.data.authorId == request.auth.uid
        && resource.data.get('type', 'original') != 'repost'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['content', 'topics', 'editedAt', 'editVersion'])
        && request.resource.data.content is string
        && (request.resource.data.content.size() <= 500
          || (isPremiumUidAfter(request.auth.uid) && request.resource.data.content.size() <= 20000))
        && (request.resource.data.content.size() >= 1
          || request.resource.data.get('imageData', '').size() > 0
          || request.resource.data.get('media', []).size() > 0)
        && validPhaseBTopics(request.resource.data.get('topics', []))
        && request.resource.data.editedAt == request.time
        && request.resource.data.editVersion is int
        && request.resource.data.editVersion == resource.data.get('editVersion', 0) + 1;
    }

    function validPhaseBCommentEdit() {
      return activeUserAfter()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['text', 'editedAt', 'editVersion'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280
        && request.resource.data.editedAt == request.time
        && request.resource.data.editVersion is int
        && request.resource.data.editVersion == resource.data.get('editVersion', 0) + 1;
    }

    function phaseBEditParentOwned(documentPath) {
      let parent = get(/databases/$(database)/documents/$(documentPath)).data;
      return signedIn()
        && ((parent.keys().hasAny(['authorId']) && parent.authorId == request.auth.uid)
          || (parent.keys().hasAny(['uid']) && parent.uid == request.auth.uid));
    }

    function validPhaseBEditHistoryCreate(documentPath) {
      let before = get(/databases/$(database)/documents/$(documentPath)).data;
      let after = getAfter(/databases/$(database)/documents/$(documentPath)).data;
      return activeUserAfter()
        && phaseBEditParentOwned(documentPath)
        && request.resource.data.keys().hasOnly(['content', 'editVersion', 'editorUid', 'archivedAt'])
        && request.resource.data.editorUid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 20000
        && request.resource.data.editVersion == before.get('editVersion', 0)
        && request.resource.data.archivedAt == request.time
        && ((before.keys().hasAny(['content']) && request.resource.data.content == before.content)
          || (before.keys().hasAny(['text']) && request.resource.data.content == before.text))
        && after.get('editVersion', 0) == before.get('editVersion', 0) + 1
        && after.editedAt == request.time;
    }

    function validOriginalPost() {
      return request.resource.data.keys().hasOnly([
          'type', 'authorId', 'username', 'content', 'imageData', 'media', 'category',
          'options', 'expiresAt', 'moderationState', 'createdAt', 'topics'
        ])
        && request.resource.data.type == 'original'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.content is string
        && (request.resource.data.content.size() <= 500
          || (isPremiumUidAfter(request.auth.uid) && request.resource.data.content.size() <= 20000))
        && (request.resource.data.content.size() >= 1
          || request.resource.data.get('imageData', '').size() > 0
          || request.resource.data.get('media', []).size() > 0)
        && request.resource.data.get('imageData', '').size() <= 160000
        && validPhaseBMedia(request.resource.data.get('media', []))
        && validPhaseBTopics(request.resource.data.get('topics', []))
        && request.resource.data.get('category', 'Post') in ['Post', 'Question', 'Confession', 'Advice', 'Rant', 'Good News', 'Poll']
        && request.resource.data.get('options', []) is list
        && request.resource.data.get('options', []).size() <= 4
        && (request.resource.data.get('category', 'Post') != 'Poll'
          || request.resource.data.get('options', []).size() >= 2)
        && (request.resource.data.get('expiresAt', null) == null
          || (request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time))
        && request.resource.data.moderationState == 'visible'
        && request.resource.data.createdAt == request.time;
    }

    function validRepost(postId) {
      let original = getAfter(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId));
      return request.resource.data.keys().hasOnly([
          'type', 'authorId', 'username', 'sourceCollection', 'originalPostId',
          'originalAuthorId', 'originalUsername', 'content', 'imageData', 'media',
          'moderationState', 'createdAt', 'topics'
        ])
        && request.resource.data.type == 'repost'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.sourceCollection == 'posts'
        && postId == 'repost_' + request.auth.uid + '_' + request.resource.data.originalPostId
        && original.data.type == 'original'
        && original.data.get('moderationState', 'visible') != 'hidden'
        && request.resource.data.originalAuthorId == original.data.authorId
        && request.resource.data.originalUsername == original.data.username
        && accountAvailableAfter(original.data.authorId)
        && request.resource.data.content == original.data.content
        && request.resource.data.get('imageData', '') == original.data.get('imageData', '')
        && validPhaseBMedia(request.resource.data.get('media', []))
        && validPhaseBTopics(request.resource.data.get('topics', []))
        && request.resource.data.moderationState == 'visible'
        && request.resource.data.createdAt == request.time;
    }

    match /siteSettings/{settingId} {
      allow read: if settingId in ['features', 'announcement'] || isAdmin();
      allow write: if isAdmin();
    }

    match /accountModeration/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin()
        && exists(/databases/$(database)/documents/users/$(uid))
        && !isProtectedAdministrator(get(/databases/$(database)/documents/users/$(uid)).data.username);
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system/accountStats {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'limit', 'updatedAt'])
        && request.resource.data.limit == 500
        && request.resource.data.updatedAt == request.time
        && ((activeUserAfter() && request.resource.data.count == 5)
          || (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(request.auth.uid))
            && request.resource.data.count == 6));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'limit', 'updatedAt'])
        && request.resource.data.limit == 500
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= request.resource.data.limit
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(request.auth.uid)))
          ||
          (request.resource.data.count == resource.data.count - 1
            && request.resource.data.count >= 0
            && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)))
        );
      allow delete: if false;
    }

    match /system/deletionProcessor {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /system/notificationProcessor {
      allow read, create, update, delete: if false;
    }

    match /system/moderationProcessor {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /reportIntakes/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if activeUserAfter()
        && validReportIntake(reportId)
        && exactReceiptAfterIntake();
      allow update, delete: if false;
    }

    match /reportReceipts/{reporterUid}/{targetKind}/{targetId} {
      allow get: if signedIn()
        && reporterUid == request.auth.uid
        && targetKind in ['post', 'communityPost', 'room', 'roomMessage', 'user']
        && reportReceiptTargetExists(targetKind, targetId);
      allow list: if false;
      allow create: if activeUserAfter()
        && reporterUid == request.auth.uid
        && targetKind in ['post', 'communityPost', 'room', 'roomMessage', 'user']
        && request.resource.data.keys().hasOnly(['reporterUid', 'targetKind', 'targetId', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetKind == targetKind
        && request.resource.data.targetId == targetId
        && request.resource.data.createdAt == request.time
        && exactIntakeAfterReceipt(reporterUid, targetKind, targetId);
      allow update, delete: if false;
    }

    match /moderationCases/{caseId} {
      allow read: if isAdmin();
      allow create: if validImmediateReportCase(caseId) || validAdminDeletionCase(caseId);
      allow update: if validImmediateReportCase(caseId)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'resolvedAt', 'resolvedBy'])
          && request.resource.data.status in ['restored', 'deleted']
          && request.resource.data.updatedAt == request.time
          && request.resource.data.resolvedAt == request.time
          && request.resource.data.resolvedBy == request.auth.uid);
      allow delete: if false;

      match /reports/{reportId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }

      match /evidence/{evidenceId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /moderationActions/{caseId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validQueuedModerationAction(caseId);
      allow update: if isAdmin() && validTerminalModerationActionRetry(caseId);
      allow delete: if false;
    }

    match /legacyRoomQuarantine/{roomId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /legacyRoomActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validLegacyRoomAction();
      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if isAdmin() || (signedIn()
        && (resource.data.blockerUid == request.auth.uid
          || resource.data.blockedUid == request.auth.uid));
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt'])
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && accountAvailableAfter(request.resource.data.blockedUid)
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
    }

    match /pageViews/{day} {
      allow read: if isAdmin();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['date', 'views', 'updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.views == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['date', 'views', 'updatedAt'])
        && request.resource.data.date == resource.data.date
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /usernames/{normalizedUsername} {
      allow read: if signedIn();
      allow create: if signedIn()
        && accountAvailableAfter(request.auth.uid)
        && !exists(/databases/$(database)/documents/usernames/$(normalizedUsername))
        && !isProtectedAdministrator(normalizedUsername)
        && !isProtectedAdministrator(request.resource.data.username)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
        && request.resource.data.username.lower() == normalizedUsername
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          == request.resource.data.username
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if activeUser()
        && resource.data.uid == request.auth.uid
        && (
          (exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
            && resource.data.username.lower() == normalizedUsername)
          ||
          (getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower()
            != normalizedUsername)
        );
    }

    match /e2eePublicKeys/{uid} {
      allow read: if activeUser();
      allow create: if activeUserAfter()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'version', 'algorithm', 'publicJwk', 'fingerprint', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.version == 1
        && request.resource.data.algorithm == 'P-256'
        && request.resource.data.publicJwk is map
        && request.resource.data.publicJwk.keys().hasOnly(['key_ops', 'ext', 'kty', 'x', 'y', 'crv'])
        && request.resource.data.publicJwk.kty == 'EC'
        && request.resource.data.publicJwk.crv == 'P-256'
        && request.resource.data.publicJwk.x is string
        && request.resource.data.publicJwk.x.size() <= 64
        && request.resource.data.publicJwk.y is string
        && request.resource.data.publicJwk.y.size() <= 64
        && request.resource.data.fingerprint is string
        && request.resource.data.fingerprint.size() == 29
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /e2eePrivateKeys/{uid} {
      allow read: if activeUser() && uid == request.auth.uid;
      allow create: if activeUserAfter()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'version', 'privateBundle', 'publicFingerprint', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.version == 1
        && request.resource.data.privateBundle is map
        && request.resource.data.privateBundle.keys().hasOnly(['version', 'algorithm', 'iterations', 'salt', 'iv', 'ciphertext'])
        && request.resource.data.privateBundle.version == 1
        && request.resource.data.privateBundle.algorithm == 'P-256+PBKDF2-SHA256+A256GCM'
        && request.resource.data.privateBundle.iterations >= 600000
        && request.resource.data.privateBundle.salt is string
        && request.resource.data.privateBundle.salt.size() <= 32
        && request.resource.data.privateBundle.iv is string
        && request.resource.data.privateBundle.iv.size() <= 24
        && request.resource.data.privateBundle.ciphertext is string
        && request.resource.data.privateBundle.ciphertext.size() <= 2048
        && request.resource.data.publicFingerprint is string
        && request.resource.data.publicFingerprint.size() == 29
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /e2eeRoomKeyEnvelopes/{envelopeId} {
      allow read: if activeUser() && (resource.data.recipientUid == request.auth.uid
        || (resource.data.kind == 'temporary' && temporaryRoomMember(resource.data.roomId, request.auth.uid))
        || (resource.data.kind == 'premium' && premiumRoomMember(resource.data.roomId, request.auth.uid))
        || (resource.data.kind == 'privateGroup' && isGroupMember(resource.data.roomId, request.auth.uid)));
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['kind', 'roomId', 'recipientUid', 'senderUid', 'envelope', 'version', 'createdAt'])
        && request.resource.data.kind in ['temporary', 'premium', 'privateGroup']
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() > 0
        && request.resource.data.recipientUid is string
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.version == 1
        && envelopeId == request.resource.data.kind + '_' + request.resource.data.roomId + '_' + request.resource.data.recipientUid
        && validEncryptedEnvelope(request.resource.data.envelope, 1024)
        && existsAfter(/databases/$(database)/documents/e2eePublicKeys/$(request.resource.data.recipientUid))
        && ((request.resource.data.kind == 'temporary'
            && roomAvailableAfter(request.resource.data.roomId)
            && temporaryRoomMemberAfter(request.resource.data.roomId, request.auth.uid)
            && temporaryRoomMemberAfter(request.resource.data.roomId, request.resource.data.recipientUid))
          || (request.resource.data.kind == 'premium'
            && premiumRoomMemberAfter(request.resource.data.roomId, request.auth.uid)
            && premiumRoomMemberAfter(request.resource.data.roomId, request.resource.data.recipientUid))
          || (request.resource.data.kind == 'privateGroup'
            && isGroupMemberAfter(request.resource.data.roomId, request.auth.uid)
            && isGroupMemberAfter(request.resource.data.roomId, request.resource.data.recipientUid)
            && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.roomId)).data.visibility == 'private'
            && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.roomId)).data.encrypted == true))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.recipientUid == request.auth.uid
          || (resource.data.kind == 'privateGroup' && isGroupModerator(resource.data.roomId)));
    }

    match /pushSubscriptions/{subscriptionId} {
      allow get, list: if pushReadDeleteUser()
        && resource.data.uid == request.auth.uid;
      allow create: if activePushUserAfter()
        && validPushSubscriptionId(subscriptionId)
        && validPushSubscription()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if activePushUserAfter()
        && validPushSubscriptionId(subscriptionId)
        && resource.data.uid == request.auth.uid
        && validPushSubscription()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.endpoint == resource.data.endpoint
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'expirationTime', 'p256dh', 'auth', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if pushReadDeleteUser()
        && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && featureEnabled('registrationsEnabled')
        && request.auth.uid == userId
        && accountAvailableAfter(userId)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt', 'lastActiveAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
        && !isProtectedAdministrator(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActiveAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.username
          == request.resource.data.username
        && ((exists(/databases/$(database)/documents/system/accountStats)
          && getAfter(/databases/$(database)/documents/system/accountStats).data.count
            == get(/databases/$(database)/documents/system/accountStats).data.count + 1)
          || (!exists(/databases/$(database)/documents/system/accountStats)
            && getAfter(/databases/$(database)/documents/system/accountStats).data.count == 6));
      allow update: if validStandaloneAdminAccountControl(userId)
        || validDeletionQueueProfile(userId)
        || (activeUserAfter()
          && request.auth.uid == userId
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
              && request.resource.data.lastActiveAt == request.time
              && (!resource.data.keys().hasAny(['lastActiveAt'])
                || (resource.data.lastActiveAt is timestamp
                  && request.time - resource.data.lastActiveAt >= duration.value(24, 'h'))))
            ||
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['profileImage', 'coverImage'])
              && featureEnabled('uploadsEnabled')
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileImage'])
                || request.resource.data.get('profileImage', '').size() <= 160000)
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coverImage'])
                || request.resource.data.get('coverImage', '').size() <= 160000))
            ||
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['freeAvatarId', 'freeCoverId'])
              && request.resource.data.get('freeAvatarId', '') is string
              && request.resource.data.get('freeCoverId', '') is string
              && (request.resource.data.get('freeAvatarId', '') == ''
                || request.resource.data.get('freeAvatarId', '').matches('free-avatar-[1-8]'))
              && (request.resource.data.get('freeCoverId', '') == ''
                || request.resource.data.get('freeCoverId', '').matches('free-cover-[1-4]')))
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
              && (!isProtectedAdministrator(resource.data.username)
                || request.resource.data.username.lower() == resource.data.username.lower())
              && request.resource.data.username is string
              && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
              && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()))
              && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid
                == request.auth.uid)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spotifyTrackUrl'])
              && featureEnabled('spotifyEmbedsEnabled')
              && request.resource.data.get('spotifyTrackUrl', '') is string
              && request.resource.data.get('spotifyTrackUrl', '').size() <= 200
              && (request.resource.data.get('spotifyTrackUrl', '') == ''
                || request.resource.data.get('spotifyTrackUrl', '')
                  .matches('https://open[.]spotify[.]com/track/[A-Za-z0-9]{22}')))
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spotifyPlaylistUrl'])
              && featureEnabled('spotifyEmbedsEnabled')
              && isPremiumUidAfter(userId)
              && request.resource.data.get('spotifyPlaylistUrl', '') is string
              && request.resource.data.get('spotifyPlaylistUrl', '').size() <= 220
              && (request.resource.data.get('spotifyPlaylistUrl', '') == ''
                || request.resource.data.get('spotifyPlaylistUrl', '')
                  .matches('https://open[.]spotify[.]com/playlist/[A-Za-z0-9]+')))
            ||
            validProfilePrivacyUpdate(userId)
            ||
            validProfilePinUpdate(userId)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bio'])
              && request.resource.data.get('bio', '') is string
              && request.resource.data.get('bio', '').size() <= 300)
          ));
      allow delete: if activeUser()
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
          && !isProtectedAdministrator(resource.data.username);
    }

    match /badgeTypes/{badgeId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'imageUrl', 'category', 'awardMode',
          'milestoneMetric', 'milestoneThreshold', 'active',
          'createdAt', 'createdBy', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 280
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 500
        && (request.resource.data.imageUrl == ''
          || request.resource.data.imageUrl.matches('https://.+'))
        && request.resource.data.category in [
          'early_supporter', 'staff', 'contributor', 'popular_post',
          'community_helper', 'long_time_member', 'premium', 'event',
          'milestone', 'special'
        ]
        && request.resource.data.awardMode in ['automatic', 'manual']
        && request.resource.data.active is bool
        && ((request.resource.data.awardMode == 'manual'
            && request.resource.data.milestoneMetric == null
            && request.resource.data.milestoneThreshold == null)
          || (request.resource.data.awardMode == 'automatic'
            && request.resource.data.milestoneMetric in [
              'posts_created', 'single_post_interactions',
              'total_interactions_received', 'comments_received',
              'comments_or_replies_created', 'followers_count',
              'account_age_days', 'early_member', 'premium_active'
            ]
            && (((request.resource.data.milestoneMetric == 'early_member'
                || request.resource.data.milestoneMetric == 'premium_active')
                && request.resource.data.milestoneThreshold == null)
              || (!(request.resource.data.milestoneMetric in ['early_member', 'premium_active'])
                && request.resource.data.milestoneThreshold is int
                && request.resource.data.milestoneThreshold > 0))))
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'imageUrl', 'category', 'awardMode',
          'milestoneMetric', 'milestoneThreshold', 'active',
          'createdAt', 'createdBy', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 280
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 500
        && (request.resource.data.imageUrl == ''
          || request.resource.data.imageUrl.matches('https://.+'))
        && request.resource.data.category in [
          'early_supporter', 'staff', 'contributor', 'popular_post',
          'community_helper', 'long_time_member', 'premium', 'event',
          'milestone', 'special'
        ]
        && request.resource.data.awardMode in ['automatic', 'manual']
        && request.resource.data.active is bool
        && ((request.resource.data.awardMode == 'manual'
            && request.resource.data.milestoneMetric == null
            && request.resource.data.milestoneThreshold == null)
          || (request.resource.data.awardMode == 'automatic'
            && request.resource.data.milestoneMetric in [
              'posts_created', 'single_post_interactions',
              'total_interactions_received', 'comments_received',
              'comments_or_replies_created', 'followers_count',
              'account_age_days', 'early_member', 'premium_active'
            ]
            && (((request.resource.data.milestoneMetric == 'early_member'
                || request.resource.data.milestoneMetric == 'premium_active')
                && request.resource.data.milestoneThreshold == null)
              || (!(request.resource.data.milestoneMetric in ['early_member', 'premium_active'])
                && request.resource.data.milestoneThreshold is int
                && request.resource.data.milestoneThreshold > 0))))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /users/{userId}/badges/{badgeId} {
      allow read: if profileBadgesReadable(userId);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/saved/{entryId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if activeUserAfter()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'postPath', 'savedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postPath is string
        && request.resource.data.postPath.matches('^(posts|communityPosts)/[^/]+$')
        && request.resource.data.savedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/viewHistory/{entryId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if activeUserAfter()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'postPath', 'viewedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postPath is string
        && request.resource.data.postPath.matches('^(posts|communityPosts)/[^/]+$')
        && request.resource.data.viewedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/recentSearches/{entryId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if activeUserAfter()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'value', 'searchedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.value is string
        && request.resource.data.value.size() >= 1
        && request.resource.data.value.size() <= 200
        && request.resource.data.searchedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /adminDeletionJobs/{targetUid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == targetUid && resource.data.get('requestType', '') == 'self');
      allow create: if (isAdmin()
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && !isProtectedAdministrator(
          get(/databases/$(database)/documents/users/$(targetUid)).data.username
        )
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(targetUid))
        && matchingDeletionQueueJob(request.resource.data, targetUid)
        && existsAfter(/databases/$(database)/documents/users/$(targetUid))
        && hasNoDeletionQueueState(
          get(/databases/$(database)/documents/users/$(targetUid)).data
        )
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data
          .diff(get(/databases/$(database)/documents/users/$(targetUid)).data)
          .affectedKeys().hasOnly([
            'banned', 'adminDeletionRequestedAt', 'adminDeletionRequestedBy', 'adminDeletionStatus'
          ])
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.banned == true
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.adminDeletionRequestedAt
          == request.time
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.adminDeletionRequestedBy
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.adminDeletionStatus
          == 'queued')
        || (signedIn()
          && request.auth.uid == targetUid
          && exists(/databases/$(database)/documents/users/$(targetUid))
          && !isProtectedAdministrator(get(/databases/$(database)/documents/users/$(targetUid)).data.username)
          && !exists(/databases/$(database)/documents/adminDeletionJobs/$(targetUid))
          && existsAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid))
          && getAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid)).data.keys()
            .hasOnly(['uid', 'username', 'createdAt'])
          && getAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid)).data.uid == targetUid
          && getAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid)).data.username
            == get(/databases/$(database)/documents/users/$(targetUid)).data.username
          && getAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid)).data.createdAt is timestamp
          && matchingSelfDeletionQueueJob(
            request.resource.data,
            targetUid,
            getAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid)).data.createdAt
          ));
      allow update, delete: if false;
    }

    match /accountDeletionRequests/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if activeUser()
        && request.auth.uid == userId
        && !isProtectedAdministrator(currentUsername())
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(userId))
        && matchingSelfDeletionQueueJob(
          getAfter(/databases/$(database)/documents/adminDeletionJobs/$(userId)).data,
          userId,
          request.time
        );
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(userId));
    }

    match /premiumAccess/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /premiumSettings/{userId} {
      allow read: if signedIn();
      allow create, update: if activeUserAfter()
        && request.auth.uid == userId
        && isPremiumUidAfter(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'onlineVisible', 'avatarId', 'coverId', 'accent', 'profileFrame', 'cardStyle', 'bannerStyle',
          'chatBubbleColor', 'timelineFeedColor', 'communityBackgroundColor', 'privateBoxColor',
          'privateChatBubbleColor', 'temporaryChatBubbleColor', 'pageColor', 'headerColor', 'menuColor',
          'profileColor', 'composerColor', 'timelineColor', 'postColor', 'buttonColor', 'inputColor',
          'textColor', 'commentColor', 'temporaryBoxColor', 'spotifyPlaylistUrl', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.spotifyPlaylistUrl is string
        && request.resource.data.spotifyPlaylistUrl.size() <= 220
        && (request.resource.data.spotifyPlaylistUrl == ''
          || request.resource.data.spotifyPlaylistUrl.matches('https://open[.]spotify[.]com/playlist/[A-Za-z0-9]+'))
        && request.resource.data.onlineVisible is bool
        && request.resource.data.avatarId in ['none', 'avatar-1', 'avatar-2', 'avatar-3', 'avatar-4', 'avatar-5', 'avatar-6', 'avatar-7', 'avatar-8', 'avatar-9', 'avatar-10', 'avatar-11', 'avatar-12', 'female-1', 'female-2', 'female-3', 'female-4', 'female-5', 'female-6', 'female-7', 'female-8', 'female-9', 'female-10', 'female-11', 'female-12']
        && request.resource.data.coverId in ['none', 'cover-1', 'cover-2', 'cover-3', 'cover-4', 'cover-5', 'cover-6', 'cover-7', 'cover-8', 'cover-9', 'cover-10', 'cover-11', 'cover-12']
        && request.resource.data.accent in ['violet', 'rose', 'ocean', 'emerald']
        && request.resource.data.profileFrame in ['glow', 'double', 'minimal']
        && request.resource.data.cardStyle in ['glass', 'solid', 'outline']
        && request.resource.data.bannerStyle in ['midnight', 'aurora', 'ember']
        && request.resource.data.chatBubbleColor in ['black', 'white', 'gray', 'red', 'orange', 'yellow', 'green', 'blue', 'purple', 'pink', 'brown', 'teal']
        && request.resource.data.timelineFeedColor in ['black', 'white', 'gray', 'red', 'orange', 'yellow', 'green', 'blue', 'purple', 'pink', 'brown', 'teal']
        && request.resource.data.communityBackgroundColor in ['black', 'white', 'gray', 'red', 'orange', 'yellow', 'green', 'blue', 'purple', 'pink', 'brown', 'teal']
        && request.resource.data.privateBoxColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.privateChatBubbleColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.temporaryChatBubbleColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.pageColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.headerColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.menuColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.profileColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.composerColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.timelineColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.postColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.buttonColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.inputColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.textColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.commentColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.temporaryBoxColor in ['black','white','gray','silver','red','orange','yellow','green','blue','purple','pink','brown','teal','navy','neonPink','neonPurple','neonBlue','neonCyan','neonGreen','neonYellow','neonOrange','neonRed','sunset','oceanGlow','purpleRain','fireIce','limeSky','candy','midnightTeal','goldPurple','redBlack','galaxy','watermelon','royal']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /premiumCheckout/{documentId} {
      allow read: if signedIn() && documentId == 'public';
      allow write: if false;
    }

    match /customers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;

      match /checkout_sessions/{sessionId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if activeUserAfter() && request.auth.uid == userId
          && exists(/databases/$(database)/documents/premiumCheckout/public)
          && get(/databases/$(database)/documents/premiumCheckout/public).data.mode == 'test'
          && get(/databases/$(database)/documents/premiumCheckout/public).data.enabled == true
          && request.resource.data.keys().hasOnly(['price', 'success_url', 'cancel_url'])
          && request.resource.data.price == get(/databases/$(database)/documents/premiumCheckout/public).data.priceId
          && request.resource.data.success_url == 'https://anonchatlogin.web.app/premium.html?checkout=success'
          && request.resource.data.cancel_url == 'https://anonchatlogin.web.app/premium.html?checkout=cancelled';
        allow update, delete: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && accountAvailableAfter(request.resource.data.followingId)
        && !pairIsBlocked(request.auth.uid, request.resource.data.followingId)
        && followId == request.auth.uid + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
    }

    match /appPresence/{userId} {
      allow read: if activeUser()
        && (request.auth.uid == userId
          || exists(/databases/$(database)/documents/follows/$(userId + '_' + request.auth.uid)));
      allow create, update: if activeUserAfter()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'openedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.openedAt == request.time;
      allow delete: if activeUser() && request.auth.uid == userId;
    }

    match /notificationReads/{readId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if activeUserAfter()
        && readId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'readAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.eventId.matches('^event-[0-9a-f]{16}$')
        && request.resource.data.readAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /notificationEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, create, update, delete: if false;
    }

    match /{documentPath=**}/comments/{commentId} {
      allow read: if signedIn() && visibleContentOrAdmin(documentPath);
      allow create: if activeUserAfter()
        && featureEnabled('commentsEnabled')
        && contentAvailableAfter(documentPath)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'text', 'parentCommentId', 'threadRootId', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280
        && ((!request.resource.data.keys().hasAny(['parentCommentId', 'threadRootId']))
          || (request.resource.data.keys().hasAll(['parentCommentId', 'threadRootId'])
            && request.resource.data.parentCommentId is string
            && request.resource.data.threadRootId is string
            && request.resource.data.parentCommentId.size() > 0
            && request.resource.data.threadRootId.size() > 0
            && existsAfter(/databases/$(database)/documents/$(documentPath)/comments/$(request.resource.data.parentCommentId))
            && existsAfter(/databases/$(database)/documents/$(documentPath)/comments/$(request.resource.data.threadRootId))
            && !getAfter(/databases/$(database)/documents/$(documentPath)/comments/$(request.resource.data.threadRootId)).data.keys().hasAny(['parentCommentId'])))
        && request.resource.data.createdAt == request.time;
      allow update: if validPhaseBCommentEdit();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    match /{documentPath=**}/editHistory/{versionId} {
      allow read: if isAdmin();
      allow create: if validPhaseBEditHistoryCreate(documentPath);
      allow update, delete: if false;
    }

    match /{documentPath=**}/reactions/{reactionId} {
      allow read: if signedIn() && visibleContentOrAdmin(documentPath);
      allow create: if activeUserAfter()
        && contentAvailableAfter(documentPath)
        && reactionId == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['wow', 'middle_finger', 'laugh', 'smile', 'fire', 'heart', 'sad']
        && request.resource.data.createdAt == request.time;
      allow update: if activeUserAfter()
        && contentAvailableAfter(documentPath)
        && reactionId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['wow', 'middle_finger', 'laugh', 'smile', 'fire', 'heart', 'sad']
        && request.resource.data.createdAt == request.time;
      allow delete: if (signedIn()
          && reactionId == request.auth.uid
          && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    function acceptedConversation(requestId) {
      let conversation = get(/databases/$(database)/documents/messageRequests/$(requestId));
      return exists(/databases/$(database)/documents/messageRequests/$(requestId))
        && conversation.data.status == 'accepted'
        && (requestId == conversation.data.fromId + '_' + conversation.data.toId
          || requestId == conversation.data.toId + '_' + conversation.data.fromId)
        && (conversation.data.fromId == request.auth.uid
          || conversation.data.toId == request.auth.uid)
        && !pairIsBlocked(conversation.data.fromId, conversation.data.toId);
    }

    function acceptedConversationMessageAfter(requestId, message) {
      let conversation = getAfter(/databases/$(database)/documents/messageRequests/$(requestId));
      return existsAfter(/databases/$(database)/documents/messageRequests/$(requestId))
        && conversation.data.status == 'accepted'
        && (requestId == conversation.data.fromId + '_' + conversation.data.toId
          || requestId == conversation.data.toId + '_' + conversation.data.fromId)
        && (conversation.data.fromId == request.auth.uid
          || conversation.data.toId == request.auth.uid)
        && accountAvailableAfter(conversation.data.fromId)
        && accountAvailableAfter(conversation.data.toId)
        && !pairIsBlocked(conversation.data.fromId, conversation.data.toId)
        && message.participants is list
        && message.participants.size() == 2
        && conversation.data.fromId in message.participants
        && conversation.data.toId in message.participants
        && message.senderId == request.auth.uid;
    }

    function acceptedChat(otherId) {
      return !pairIsBlocked(request.auth.uid, otherId)
        && ((exists(/databases/$(database)/documents/messageRequests/$(request.auth.uid + '_' + otherId))
          && get(/databases/$(database)/documents/messageRequests/$(request.auth.uid + '_' + otherId)).data.status == 'accepted')
        || (exists(/databases/$(database)/documents/messageRequests/$(otherId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/messageRequests/$(otherId + '_' + request.auth.uid)).data.status == 'accepted'));
    }

    function mutualReveal(otherId) {
      return !pairIsBlocked(request.auth.uid, otherId)
        && exists(/databases/$(database)/documents/reveals/$(request.auth.uid + '_' + otherId))
        && exists(/databases/$(database)/documents/reveals/$(otherId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/reveals/$(request.auth.uid + '_' + otherId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/reveals/$(otherId + '_' + request.auth.uid)).data.status == 'accepted';
    }

    match /userPrivate/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || mutualReveal(userId));
      allow create, update: if activeUserAfter()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'interests', 'region', 'ageRange', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.interests is string
        && request.resource.data.interests.size() <= 100
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 60
        && request.resource.data.ageRange is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /userPreferences/{userId} {
      allow read: if activeUser() && request.auth.uid == userId;
      allow create, update: if activeUserAfter() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'mutedKeywords', 'contextCheck', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mutedKeywords is list
        && request.resource.data.mutedKeywords.size() <= 20
        && request.resource.data.contextCheck is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /circles/{circleId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 180
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (activeUser() && resource.data.ownerId == request.auth.uid);
    }

    match /circleMembers/{memberId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && memberId == request.resource.data.circleId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['circleId', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && circleAvailableAfter(request.resource.data.circleId)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn()
        && (resource.data.visibility == 'public' || isGroupMember(groupId, request.auth.uid) || isAdmin());
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['name', 'slug', 'description', 'topic', 'ownerId', 'visibility', 'premiumRequired', 'encrypted', 'cipherVersion', 'status', 'memberCount', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60
        && request.resource.data.slug is string
        && request.resource.data.slug.matches('^[a-z0-9-]{3,60}$')
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.topic is string
        && request.resource.data.topic.size() >= 1
        && request.resource.data.topic.size() <= 60
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.visibility in ['public', 'private']
        && ((request.resource.data.visibility == 'public'
            && request.resource.data.premiumRequired == false
            && !request.resource.data.keys().hasAny(['encrypted', 'cipherVersion']))
          || (request.resource.data.visibility == 'private'
            && request.resource.data.premiumRequired == true
            && request.resource.data.encrypted == true
            && request.resource.data.cipherVersion == 1
            && isPremiumUidAfter(request.auth.uid)))
        && request.resource.data.status == 'active'
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner'
        && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.joinedAt == request.time;
      allow update: if (isGroupOwner(groupId)
          && request.resource.data.keys().hasOnly(['name', 'slug', 'description', 'topic', 'ownerId', 'visibility', 'premiumRequired', 'encrypted', 'cipherVersion', 'status', 'memberCount', 'createdAt', 'updatedAt'])
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.visibility == resource.data.visibility
          && request.resource.data.premiumRequired == resource.data.premiumRequired
          && request.resource.data.get('encrypted', false) == resource.data.get('encrypted', false)
          && request.resource.data.get('cipherVersion', 0) == resource.data.get('cipherVersion', 0)
          && request.resource.data.memberCount == resource.data.memberCount
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['active', 'archived']
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'topic', 'status', 'updatedAt']))
        || validGroupMemberCountUpdate(groupId);
      allow delete: if false;
    }

    match /groups/{groupId}/members/{userId} {
      allow read: if signedIn()
        && (get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public'
          || isGroupMember(groupId, request.auth.uid)
          || isAdmin());
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['uid', 'role', 'joinedAt', 'invitedBy'])
        && request.resource.data.uid == userId
        && request.resource.data.role in ['owner', 'moderator', 'member']
        && request.resource.data.joinedAt == request.time
        && ((userId == request.auth.uid
            && request.resource.data.role == 'owner'
            && existsAfter(/databases/$(database)/documents/groups/$(groupId))
            && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid)
          || (userId == request.auth.uid
            && request.resource.data.role == 'member'
            && groupPublicAfter(groupId)
            && !request.resource.data.keys().hasAny(['invitedBy']))
          || (userId != request.auth.uid
            && request.resource.data.role == 'member'
            && groupActiveAfter(groupId)
            && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'private'
            && isGroupModerator(groupId)
            && request.resource.data.invitedBy == request.auth.uid));
      allow update: if activeUserAfter()
        && isGroupOwner(groupId)
        && resource.data.role != 'owner'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.get('invitedBy', '') == resource.data.get('invitedBy', '')
        && request.resource.data.role in ['moderator', 'member']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
      allow delete: if signedIn()
        && resource.data.role != 'owner'
        && ((userId == request.auth.uid)
          || (isGroupOwner(groupId))
          || (isGroupModerator(groupId) && resource.data.role == 'member'));
    }

    match /groups/{groupId}/privateGroupMessages/{messageId} {
      allow read: if activeUser() && isGroupMember(groupId, request.auth.uid);
      allow create: if activeUserAfter()
        && isGroupMemberAfter(groupId, request.auth.uid)
        && existsAfter(/databases/$(database)/documents/groups/$(groupId))
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'private'
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.premiumRequired == true
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.encrypted == true
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.status == 'active'
        && request.resource.data.keys().hasOnly(['senderId', 'encrypted', 'cipherVersion', 'bodyCipher', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.encrypted == true
        && request.resource.data.cipherVersion == 1
        && request.resource.data.bodyCipher is map
        && request.resource.data.bodyCipher.keys().hasOnly(['version', 'algorithm', 'iv', 'ciphertext'])
        && request.resource.data.bodyCipher.version == 1
        && request.resource.data.bodyCipher.algorithm == 'A256GCM'
        && request.resource.data.bodyCipher.iv is string
        && request.resource.data.bodyCipher.iv.size() <= 32
        && request.resource.data.bodyCipher.ciphertext is string
        && request.resource.data.bodyCipher.ciphertext.size() <= 12000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && isGroupMember(groupId, request.auth.uid)
        && (resource.data.senderId == request.auth.uid || isGroupModerator(groupId));
    }

    match /communities/{communityId} {
      allow read: if signedIn() && resource.data.visibility == 'public';
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['name', 'slug', 'description', 'topic', 'rules', 'ownerId', 'visibility', 'status', 'memberCount', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60
        && request.resource.data.slug is string
        && request.resource.data.slug.matches('^[a-z0-9-]{3,60}$')
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.topic is string
        && request.resource.data.topic.size() >= 1
        && request.resource.data.topic.size() <= 60
        && request.resource.data.rules is list
        && request.resource.data.rules.size() <= 10
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.visibility == 'public'
        && request.resource.data.status == 'active'
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role == 'owner'
        && getAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.joinedAt == request.time;
      allow update: if isInterestCommunityOwner(communityId)
        && request.resource.data.keys().hasOnly(['name', 'slug', 'description', 'topic', 'rules', 'ownerId', 'visibility', 'status', 'memberCount', 'createdAt', 'updatedAt'])
