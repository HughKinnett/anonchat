          ? resource.data.participants[1] : resource.data.participants[0]);
      allow create: if false;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /reveals/{revealId} {
      allow read: if activeUser()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['fromId', 'toId', 'fields', 'status', 'createdAt'])
        && request.resource.data.fromId == request.auth.uid
        && accountAvailableAfter(request.resource.data.toId)
        && !pairIsBlocked(request.auth.uid, request.resource.data.toId)
        && acceptedChat(request.resource.data.toId)
        && request.resource.data.fields.keys().hasOnly(['interests', 'region', 'ageRange'])
        && request.resource.data.status == 'pending'
        && revealId == request.auth.uid + '_' + request.resource.data.toId
        && request.resource.data.createdAt == request.time;
      allow update: if activeUserAfter()
        && accountAvailableAfter(resource.data.fromId)
        && accountAvailableAfter(resource.data.toId)
        && !pairIsBlocked(resource.data.fromId, resource.data.toId)
        && resource.data.toId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.respondedAt == request.time;
      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /posts/{postId}/comments/{commentId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    match /communityPosts/{postId}/comments/{commentId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId == request.auth.uid;
    }

    match /posts/{postId}/reactions/{reactionId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if signedIn() && visibleOrAdmin();
      allow create: if activeUserAfter() && featureEnabled('postingEnabled')
        && (featureEnabled('uploadsEnabled')
          || (request.resource.data.get('imageData', '') == ''
            && request.resource.data.get('media', []).size() == 0))
        && (validOriginalPost() || validRepost(postId));
      allow update: if validModerationHoldUpdate('post', postId, resource.data.authorId)
        || validAdminMaterialRestore()
        || validPhaseBPostEdit();
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }
  }
}
