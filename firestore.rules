rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountAvailable(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/users/$(uid))
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(uid));
    }

    function accountAvailableAfter(uid) {
      return uid is string
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(uid));
    }

    function hasNoDeletionBarrierAfter(uid) {
      return uid is string
        && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(uid));
    }

    function activeUserAfter() {
      return signedIn()
        && accountAvailableAfter(request.auth.uid)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true;
    }

    function moderationTargetActive(content) {
      return content.get('moderationStatus', 'active') != 'reported';
    }

    function contentAvailableAfter(documentPath) {
      return existsAfter(/databases/$(database)/documents/$(documentPath))
        && linkedContentAvailableAfter(
          getAfter(/databases/$(database)/documents/$(documentPath)).data
        );
    }

    function linkedContentAvailableAfter(content) {
      return content.keys().hasAny(['authorId', 'originalAuthorId', 'ownerId', 'senderId'])
        && moderationTargetActive(content)
        && (!content.keys().hasAny(['authorId']) || hasNoDeletionBarrierAfter(content.authorId))
        && (!content.keys().hasAny(['originalAuthorId'])
          || hasNoDeletionBarrierAfter(content.originalAuthorId))
        && (!content.keys().hasAny(['ownerId']) || hasNoDeletionBarrierAfter(content.ownerId))
        && (!content.keys().hasAny(['senderId']) || hasNoDeletionBarrierAfter(content.senderId))
        && (!content.keys().hasAny(['circleId']) || linkedCircleAvailableAfter(content.circleId))
        && (!content.keys().hasAny(['roomId']) || linkedRoomAvailableAfter(content.roomId));
    }

    function postAvailableAfter(postId) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      let communityPostPath = /databases/$(database)/documents/communityPosts/$(postId);
      return (existsAfter(postPath) || existsAfter(communityPostPath))
        && (!existsAfter(postPath)
          || linkedContentAvailableAfter(getAfter(postPath).data))
        && (!existsAfter(communityPostPath)
          || linkedContentAvailableAfter(getAfter(communityPostPath).data));
    }

    function circleAvailableAfter(circleId) {
      return existsAfter(/databases/$(database)/documents/circles/$(circleId))
        && accountAvailableAfter(getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId);
    }

    function roomAvailableAfter(roomId) {
      return existsAfter(/databases/$(database)/documents/rooms/$(roomId))
        && moderationTargetActive(
          getAfter(/databases/$(database)/documents/rooms/$(roomId)).data
        )
        && accountAvailableAfter(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId);
    }

    function linkedCircleAvailableAfter(circleId) {
      return existsAfter(/databases/$(database)/documents/circles/$(circleId))
        && hasNoDeletionBarrierAfter(getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId);
    }

    function linkedRoomAvailableAfter(roomId) {
      return existsAfter(/databases/$(database)/documents/rooms/$(roomId))
        && moderationTargetActive(
          getAfter(/databases/$(database)/documents/rooms/$(roomId)).data
        )
        && hasNoDeletionBarrierAfter(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId);
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        && hasMatchingAdminReservation(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        );
    }

    function isProtectedAdministrator(username) {
      return username is string
        && username.lower().matches('^[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*(i_love_you_h|cybercapone)[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*$');
    }

    function hasMatchingAdminReservation(profile) {
      return (
          profile.username is string
          && profile.username.lower().matches('^[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*i_love_you_h[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*$')
          && exists(/databases/$(database)/documents/usernames/i_love_you_h)
          && get(/databases/$(database)/documents/usernames/i_love_you_h).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/usernames/i_love_you_h).data.username == profile.username
        ) || (
          profile.username is string
          && profile.username.lower().matches('^[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*cybercapone[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*$')
          && exists(/databases/$(database)/documents/usernames/cybercapone)
          && get(/databases/$(database)/documents/usernames/cybercapone).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/usernames/cybercapone).data.username == profile.username
        );
    }

    function hasNoDeletionQueueState(profile) {
      return !profile.keys().hasAny([
        'adminDeletionRequestedAt', 'adminDeletionRequestedBy', 'adminDeletionStatus'
      ]);
    }

    function matchingDeletionQueueJob(job, targetUid) {
      return job.keys().hasOnly(['targetUid', 'requesterUid', 'requestedAt', 'status'])
        && job.targetUid == targetUid
        && job.requesterUid == request.auth.uid
        && job.requestedAt == request.time
        && job.status == 'queued';
    }

    function validDeletionQueueProfile(userId) {
      return isAdmin()
        && !isProtectedAdministrator(resource.data.username)
        && hasNoDeletionQueueState(resource.data)
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'banned', 'adminDeletionRequestedAt', 'adminDeletionRequestedBy', 'adminDeletionStatus'
        ])
        && request.resource.data.banned == true
        && request.resource.data.adminDeletionRequestedAt == request.time
        && request.resource.data.adminDeletionRequestedBy == request.auth.uid
        && request.resource.data.adminDeletionStatus == 'queued'
        && existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(userId))
        && matchingDeletionQueueJob(
          getAfter(/databases/$(database)/documents/adminDeletionJobs/$(userId)).data,
          userId
        );
    }

    function validStandaloneAdminBan(userId) {
      return isAdmin()
        && !isProtectedAdministrator(resource.data.username)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned'])
        && request.resource.data.banned is bool
        && (request.resource.data.banned == true
          || (hasNoDeletionQueueState(resource.data)
            && !exists(/databases/$(database)/documents/adminDeletionJobs/$(userId))));
    }

    function activeUser() {
      return signedIn()
        && accountAvailable(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true;
    }

    function validBlock(blockKey) {
      return request.resource.data.keys().hasOnly(['blockerId', 'blockedId', 'createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && blockKey == request.auth.uid + '_' + request.resource.data.blockedId
        && accountAvailableAfter(request.resource.data.blockedId)
        && request.resource.data.createdAt == request.time;
    }

    function matchingPendingReport(reportData, reportKey, targetType, targetId, ownerId) {
      return reportData.keys().hasOnly([
          'targetType', 'targetId', 'reporterId', 'reportedUserId',
          'reason', 'status', 'createdAt'
        ])
        && reportKey == targetType + '_' + targetId + '_' + request.auth.uid
        && reportData.targetType == targetType
        && reportData.targetId == targetId
        && reportData.reporterId == request.auth.uid
        && reportData.reportedUserId == ownerId
        && reportData.reportedUserId != request.auth.uid
        && reportData.reason in ['Spam', 'Harassment', 'Threats', 'Sexual content', 'Other']
        && reportData.status == 'pending'
        && reportData.createdAt == request.time;
    }

    function validPostReportCreate(reportData) {
      let targetPath = /databases/$(database)/documents/posts/$(reportData.targetId);
      let currentTarget = get(targetPath).data;
      let heldTarget = getAfter(targetPath).data;
      return exists(targetPath)
        && currentTarget.authorId == reportData.reportedUserId
        && moderationTargetActive(currentTarget)
        && heldTarget.diff(currentTarget).affectedKeys().hasOnly([
          'moderationStatus', 'reportedAt'
        ])
        && heldTarget.moderationStatus == 'reported'
        && heldTarget.reportedAt == request.time;
    }

    function validCommunityPostReportCreate(reportData) {
      let targetPath = /databases/$(database)/documents/communityPosts/$(reportData.targetId);
      let currentTarget = get(targetPath).data;
      let heldTarget = getAfter(targetPath).data;
      return exists(targetPath)
        && currentTarget.authorId == reportData.reportedUserId
        && moderationTargetActive(currentTarget)
        && heldTarget.diff(currentTarget).affectedKeys().hasOnly([
          'moderationStatus', 'reportedAt'
        ])
        && heldTarget.moderationStatus == 'reported'
        && heldTarget.reportedAt == request.time;
    }

    function validRoomReportCreate(reportData) {
      let targetPath = /databases/$(database)/documents/rooms/$(reportData.targetId);
      let currentTarget = get(targetPath).data;
      let heldTarget = getAfter(targetPath).data;
      return exists(targetPath)
        && currentTarget.ownerId == reportData.reportedUserId
        && moderationTargetActive(currentTarget)
        && heldTarget.diff(currentTarget).affectedKeys().hasOnly([
          'moderationStatus', 'reportedAt'
        ])
        && heldTarget.moderationStatus == 'reported'
        && heldTarget.reportedAt == request.time;
    }

    function validReportCreate(reportKey) {
      return activeUserAfter()
        && !isAdmin()
        && request.resource.data.targetType in ['post', 'communityPost', 'room']
        && matchingPendingReport(
          request.resource.data,
          reportKey,
          request.resource.data.targetType,
          request.resource.data.targetId,
          request.resource.data.reportedUserId
        )
        && ((request.resource.data.targetType == 'post'
            && validPostReportCreate(request.resource.data))
          || (request.resource.data.targetType == 'communityPost'
            && validCommunityPostReportCreate(request.resource.data))
          || (request.resource.data.targetType == 'room'
            && validRoomReportCreate(request.resource.data)));
    }

    function validPostReportHold(postId) {
      let reportKey = 'post_' + postId + '_' + request.auth.uid;
      let reportPath = /databases/$(database)/documents/reports/$(reportKey);
      return activeUserAfter()
        && moderationTargetActive(resource.data)
        && resource.data.authorId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationStatus', 'reportedAt'
        ])
        && request.resource.data.moderationStatus == 'reported'
        && request.resource.data.reportedAt == request.time
        && !exists(reportPath)
        && existsAfter(reportPath)
        && matchingPendingReport(
          getAfter(reportPath).data,
          reportKey,
          'post',
          postId,
          resource.data.authorId
        );
    }

    function validCommunityPostReportHold(postId) {
      let reportKey = 'communityPost_' + postId + '_' + request.auth.uid;
      let reportPath = /databases/$(database)/documents/reports/$(reportKey);
      return activeUserAfter()
        && moderationTargetActive(resource.data)
        && resource.data.authorId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationStatus', 'reportedAt'
        ])
        && request.resource.data.moderationStatus == 'reported'
        && request.resource.data.reportedAt == request.time
        && !exists(reportPath)
        && existsAfter(reportPath)
        && matchingPendingReport(
          getAfter(reportPath).data,
          reportKey,
          'communityPost',
          postId,
          resource.data.authorId
        );
    }

    function validRoomReportHold(roomId) {
      let reportKey = 'room_' + roomId + '_' + request.auth.uid;
      let reportPath = /databases/$(database)/documents/reports/$(reportKey);
      return activeUserAfter()
        && moderationTargetActive(resource.data)
        && resource.data.ownerId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationStatus', 'reportedAt'
        ])
        && request.resource.data.moderationStatus == 'reported'
        && request.resource.data.reportedAt == request.time
        && !exists(reportPath)
        && existsAfter(reportPath)
        && matchingPendingReport(
          getAfter(reportPath).data,
          reportKey,
          'room',
          roomId,
          resource.data.ownerId
        );
    }

    function matchingResolvedReport(reportData, reportKey, targetType, targetId, action, adminId) {
      return reportData.keys().hasOnly([
          'targetType', 'targetId', 'reporterId', 'reportedUserId',
          'reason', 'status', 'createdAt', 'resolvedBy',
          'resolutionAction', 'resolvedAt'
        ])
        && reportData.targetType == targetType
        && reportData.targetId == targetId
        && reportData.status == 'resolved'
        && reportData.resolvedBy == adminId
        && reportData.resolutionAction == action
        && reportData.resolvedAt == request.time
        && reportKey == targetType + '_' + targetId + '_' + reportData.reporterId;
    }

    function matchingModerationAction(actionData, actionKey, targetType, targetId, action, adminId) {
      return actionData.keys().hasOnly([
          'targetType', 'targetId', 'reportIds', 'reportCount', 'action', 'adminId', 'actedAt'
        ])
        && actionKey == targetType + '_' + targetId
        && actionData.targetType == targetType
        && actionData.targetId == targetId
        && actionData.reportIds is list
        && actionData.reportIds.size() >= 1
        && actionData.reportIds.size() <= 498
        && actionData.reportCount == actionData.reportIds.size()
        && actionData.action == action
        && actionData.adminId == adminId
        && actionData.actedAt is timestamp;
    }

    function moderationDeletionJobPath(targetType, targetId) {
      return /databases/$(database)/documents/moderationDeletionJobs/$(targetType + '_' + targetId);
    }

    function noModerationDeletionJobAfter(targetType, targetId) {
      return !existsAfter(moderationDeletionJobPath(targetType, targetId));
    }

    function matchingModerationDeletionJob(jobData, jobId) {
      return jobData.keys().hasOnly([
          'targetType', 'targetId', 'reportId', 'requesterUid', 'requestedAt', 'status'
        ])
        && jobData.targetType in ['post', 'communityPost', 'room']
        && jobData.targetId is string
        && jobData.targetId.size() > 0
        && jobData.reportId is string
        && jobData.reportId.size() > 0
        && jobData.requesterUid == request.auth.uid
        && jobData.requestedAt == request.time
        && jobData.status == 'queued'
        && jobId == jobData.targetType + '_' + jobData.targetId;
    }

    function matchingDeletionAnchor(jobData) {
      let reportPath = /databases/$(database)/documents/reports/$(jobData.reportId);
      return exists(reportPath)
        && get(reportPath).data.status == 'pending'
        && get(reportPath).data.targetType == jobData.targetType
        && get(reportPath).data.targetId == jobData.targetId;
    }

    function validModerationDeletionTarget(jobData) {
      let postPath = /databases/$(database)/documents/posts/$(jobData.targetId);
      let communityPostPath = /databases/$(database)/documents/communityPosts/$(jobData.targetId);
      let roomPath = /databases/$(database)/documents/rooms/$(jobData.targetId);
      let reportPath = /databases/$(database)/documents/reports/$(jobData.reportId);
      return (jobData.targetType == 'post'
          && exists(postPath) && existsAfter(postPath)
          && get(postPath).data.get('moderationStatus', 'active') == 'reported'
          && getAfter(postPath).data.get('moderationStatus', 'active') == 'reported'
          && get(postPath).data.authorId == get(reportPath).data.reportedUserId)
        || (jobData.targetType == 'communityPost'
          && exists(communityPostPath) && existsAfter(communityPostPath)
          && get(communityPostPath).data.get('moderationStatus', 'active') == 'reported'
          && getAfter(communityPostPath).data.get('moderationStatus', 'active') == 'reported'
          && get(communityPostPath).data.authorId == get(reportPath).data.reportedUserId)
        || (jobData.targetType == 'room'
          && exists(roomPath) && existsAfter(roomPath)
          && get(roomPath).data.get('moderationStatus', 'active') == 'reported'
          && getAfter(roomPath).data.get('moderationStatus', 'active') == 'reported'
          && get(roomPath).data.ownerId == get(reportPath).data.reportedUserId);
    }

    function validModerationDeletionQueue(jobId) {
      return isAdmin()
        && !exists(/databases/$(database)/documents/moderationDeletionJobs/$(jobId))
        && matchingModerationDeletionJob(request.resource.data, jobId)
        && matchingDeletionAnchor(request.resource.data)
        && validModerationDeletionTarget(request.resource.data);
    }

    function validPostActionState(postId, action) {
      let targetPath = /databases/$(database)/documents/posts/$(postId);
      let currentTarget = get(targetPath).data;
      return exists(targetPath)
        && currentTarget.get('moderationStatus', 'active') == 'reported'
        && ((action == 'restore-post'
            && existsAfter(targetPath)
            && getAfter(targetPath).data.diff(currentTarget).affectedKeys().hasOnly([
              'moderationStatus', 'reportedAt'
            ])
            && getAfter(targetPath).data.moderationStatus == 'active'
            && getAfter(targetPath).data.reportedAt == null
            && noModerationDeletionJobAfter('post', postId)));
    }

    function validCommunityPostActionState(postId, action) {
      let targetPath = /databases/$(database)/documents/communityPosts/$(postId);
      let currentTarget = get(targetPath).data;
      return exists(targetPath)
        && currentTarget.get('moderationStatus', 'active') == 'reported'
        && ((action == 'restore-post'
            && existsAfter(targetPath)
            && getAfter(targetPath).data.diff(currentTarget).affectedKeys().hasOnly([
              'moderationStatus', 'reportedAt'
            ])
            && getAfter(targetPath).data.moderationStatus == 'active'
            && getAfter(targetPath).data.reportedAt == null
            && noModerationDeletionJobAfter('communityPost', postId)));
    }

    function validRestoredRoomExpiry(expiresAt) {
      return expiresAt is timestamp
        && expiresAt >= request.time + duration.value(86340, 's')
        && expiresAt <= request.time + duration.value(86460, 's');
    }

    function validRoomActionState(roomId, action) {
      let targetPath = /databases/$(database)/documents/rooms/$(roomId);
      let currentTarget = get(targetPath).data;
      return exists(targetPath)
        && currentTarget.get('moderationStatus', 'active') == 'reported'
        && ((action == 'restore-room'
            && existsAfter(targetPath)
            && getAfter(targetPath).data.diff(currentTarget).affectedKeys().hasOnly([
              'moderationStatus', 'reportedAt', 'resumedAt', 'expiresAt'
            ])
            && getAfter(targetPath).data.moderationStatus == 'active'
            && getAfter(targetPath).data.reportedAt == null
            && getAfter(targetPath).data.resumedAt == request.time
            && validRestoredRoomExpiry(getAfter(targetPath).data.expiresAt)
            && noModerationDeletionJobAfter('room', roomId)));
    }

    function validActionTargetState(targetType, targetId, action) {
      return (targetType == 'post'
          && action in ['restore-post', 'delete-post']
          && validPostActionState(targetId, action))
        || (targetType == 'communityPost'
          && action in ['restore-post', 'delete-post']
          && validCommunityPostActionState(targetId, action))
        || (targetType == 'room'
          && action in ['restore-room', 'delete-room']
          && validRoomActionState(targetId, action));
    }

    function validCurrentActionForTarget(targetType, targetId, action) {
      let actionKey = targetType + '_' + targetId;
      let actionPath = /databases/$(database)/documents/moderationActions/$(actionKey);
      let actionData = getAfter(actionPath).data;
      let reportKey = actionData.reportIds[0];
      let reportPath = /databases/$(database)/documents/reports/$(reportKey);
      return existsAfter(actionPath)
        && matchingModerationAction(
          actionData,
          actionKey,
          targetType,
          targetId,
          action,
          request.auth.uid
        )
        && actionData.actedAt == request.time
        && existsAfter(reportPath)
        && matchingResolvedReport(
          getAfter(reportPath).data,
          reportKey,
          targetType,
          targetId,
          action,
          request.auth.uid
        );
    }

    function validModerationAction(actionKey) {
      let reportKey = request.resource.data.reportIds[0];
      let reportPath = /databases/$(database)/documents/reports/$(reportKey);
      return isAdmin()
        && matchingModerationAction(
          request.resource.data,
          actionKey,
          request.resource.data.targetType,
          request.resource.data.targetId,
          request.resource.data.action,
          request.auth.uid
        )
        && request.resource.data.actedAt == request.time
        && existsAfter(reportPath)
        && matchingResolvedReport(
          getAfter(reportPath).data,
          reportKey,
          request.resource.data.targetType,
          request.resource.data.targetId,
          request.resource.data.action,
          request.auth.uid
        )
        && validActionTargetState(
          request.resource.data.targetType,
          request.resource.data.targetId,
          request.resource.data.action
        );
    }

    function validReportResolution(reportKey) {
      let actionKey = resource.data.targetType + '_' + resource.data.targetId;
      let actionPath = /databases/$(database)/documents/moderationActions/$(actionKey);
      return isAdmin()
        && resource.data.keys().hasOnly([
          'targetType', 'targetId', 'reporterId', 'reportedUserId',
          'reason', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'targetType', 'targetId', 'reporterId', 'reportedUserId',
          'reason', 'status', 'createdAt', 'resolvedBy',
          'resolutionAction', 'resolvedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolvedBy', 'resolutionAction', 'resolvedAt'
        ])
        && resource.data.status == 'pending'
        && request.resource.data.status == 'resolved'
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time
        && ((resource.data.targetType in ['post', 'communityPost']
            && request.resource.data.resolutionAction in ['restore-post', 'delete-post'])
          || (resource.data.targetType == 'room'
            && request.resource.data.resolutionAction in ['restore-room', 'delete-room']))
        && existsAfter(actionPath)
        && matchingModerationAction(
          getAfter(actionPath).data,
          actionKey,
          resource.data.targetType,
          resource.data.targetId,
          request.resource.data.resolutionAction,
          request.auth.uid
        )
        && reportKey in getAfter(actionPath).data.reportIds
        && getAfter(actionPath).data.actedAt == request.time
        && validActionTargetState(
          resource.data.targetType,
          resource.data.targetId,
          request.resource.data.resolutionAction
        );
    }

    function validResolvedReportDelete(reportKey) {
      let actionKey = resource.data.targetType + '_' + resource.data.targetId;
      let actionPath = /databases/$(database)/documents/moderationActions/$(actionKey);
      return isAdmin()
        && resource.data.status == 'resolved'
        && exists(actionPath)
        && matchingModerationAction(
          get(actionPath).data,
          actionKey,
          resource.data.targetType,
          resource.data.targetId,
          resource.data.resolutionAction,
          resource.data.resolvedBy
        )
        && reportKey in get(actionPath).data.reportIds;
    }

    function validPostRestore(postId) {
      return isAdmin()
        && resource.data.get('moderationStatus', 'active') == 'reported'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationStatus', 'reportedAt'
        ])
        && request.resource.data.moderationStatus == 'active'
        && request.resource.data.reportedAt == null
        && noModerationDeletionJobAfter('post', postId)
        && validCurrentActionForTarget('post', postId, 'restore-post');
    }

    function validCommunityPostRestore(postId) {
      return isAdmin()
        && resource.data.get('moderationStatus', 'active') == 'reported'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationStatus', 'reportedAt'
        ])
        && request.resource.data.moderationStatus == 'active'
        && request.resource.data.reportedAt == null
        && noModerationDeletionJobAfter('communityPost', postId)
        && validCurrentActionForTarget('communityPost', postId, 'restore-post');
    }

    function validRoomRestore(roomId) {
      return isAdmin()
        && resource.data.get('moderationStatus', 'active') == 'reported'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationStatus', 'reportedAt', 'resumedAt', 'expiresAt'
        ])
        && request.resource.data.moderationStatus == 'active'
        && request.resource.data.reportedAt == null
        && request.resource.data.resumedAt == request.time
        && validRestoredRoomExpiry(request.resource.data.expiresAt)
        && noModerationDeletionJobAfter('room', roomId)
        && validCurrentActionForTarget('room', roomId, 'restore-room');
    }

    function validReportedTargetDelete(targetType, targetId) {
      return resource.data.get('moderationStatus', 'active') == 'reported'
        && validCurrentActionForTarget(
          targetType,
          targetId,
          targetType == 'room' ? 'delete-room' : 'delete-post'
        );
    }

    function roomEvidenceReadable(roomId) {
      return isAdmin()
        || (exists(/databases/$(database)/documents/rooms/$(roomId))
          && moderationTargetActive(
            get(/databases/$(database)/documents/rooms/$(roomId)).data
          ));
    }

    function roomEvidenceMayBeRemoved(roomId) {
      return !existsAfter(/databases/$(database)/documents/rooms/$(roomId))
        || moderationTargetActive(
          getAfter(/databases/$(database)/documents/rooms/$(roomId)).data
        );
    }

    function activePushUser() {
      return activeUser()
        && !exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function activePushUserAfter() {
      return activeUserAfter()
        && !existsAfter(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function selfDeletingPushUser() {
      return activeUser()
        && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function pushReadDeleteUser() {
      return activePushUser() || selfDeletingPushUser();
    }

    function validPushSubscriptionId(subscriptionId) {
      return subscriptionId.matches('^[0-9a-f]{64}$');
    }

    function validPushSubscription() {
      return request.resource.data.keys().hasOnly([
          'uid', 'endpoint', 'expirationTime', 'p256dh', 'auth', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.matches('^https://.*$')
        && request.resource.data.endpoint.size() <= 2048
        && (request.resource.data.expirationTime == null
          || (request.resource.data.expirationTime is int
            && request.resource.data.expirationTime >= 0))
        && request.resource.data.p256dh is string
        && request.resource.data.p256dh.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.p256dh.size() <= 128
        && request.resource.data.auth is string
        && request.resource.data.auth.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.auth.size() <= 64;
    }

    function currentUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function validPostImage(imageData) {
      return imageData is string
        && imageData.size() <= 800000
        && (imageData.size() == 0
          || imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'));
    }

    function validOriginalPost() {
      return request.resource.data.keys().hasOnly(['type', 'authorId', 'username', 'content', 'imageData', 'category', 'options', 'moderationStatus', 'expiresAt', 'createdAt'])
        && request.resource.data.keys().hasAll(['moderationStatus'])
        && request.resource.data.type == 'original'
        && request.resource.data.moderationStatus == 'active'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 500
        && (request.resource.data.content.size() >= 1
          || request.resource.data.get('imageData', '').size() > 0)
        && validPostImage(request.resource.data.get('imageData', ''))
        && request.resource.data.get('category', 'Post') in ['Post', 'Question', 'Confession', 'Advice', 'Rant', 'Good News', 'Poll']
        && request.resource.data.get('options', []) is list
        && request.resource.data.get('options', []).size() <= 4
        && (request.resource.data.get('category', 'Post') != 'Poll'
          || request.resource.data.get('options', []).size() >= 2)
        && (request.resource.data.get('expiresAt', null) == null
          || (request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time))
        && request.resource.data.createdAt == request.time;
    }

    function validRepost(postId) {
      let original = getAfter(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId));
        return request.resource.data.keys().hasOnly([
          'type', 'authorId', 'username', 'originalPostId',
          'originalAuthorId', 'originalUsername', 'content', 'imageData',
          'moderationStatus', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['moderationStatus'])
        && request.resource.data.type == 'repost'
        && request.resource.data.moderationStatus == 'active'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.username == currentUsername()
        && postId == 'repost_' + request.auth.uid + '_' + request.resource.data.originalPostId
        && original.data.type == 'original'
        && moderationTargetActive(original.data)
        && request.resource.data.originalAuthorId == original.data.authorId
        && request.resource.data.originalUsername == original.data.username
        && accountAvailableAfter(original.data.authorId)
        && request.resource.data.content == original.data.content
        && request.resource.data.get('imageData', '') == original.data.get('imageData', '')
        && validPostImage(request.resource.data.get('imageData', ''))
        && request.resource.data.createdAt == request.time;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system/accountStats {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'limit', 'updatedAt'])
        && request.resource.data.limit == 500
        && request.resource.data.updatedAt == request.time
        && ((activeUserAfter() && request.resource.data.count == 5)
          || (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(request.auth.uid))
            && request.resource.data.count == 6));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'limit', 'updatedAt'])
        && request.resource.data.limit == 500
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= request.resource.data.limit
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(request.auth.uid)))
          ||
          (request.resource.data.count == resource.data.count - 1
            && request.resource.data.count >= 0
            && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)))
        );
      allow delete: if false;
    }

    match /system/deletionProcessor {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /system/notificationProcessor {
      allow read, create, update, delete: if false;
    }

    match /system/moderationDeletionProcessor {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /pageViews/{day} {
      allow read: if isAdmin();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['date', 'views', 'updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.views == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['date', 'views', 'updatedAt'])
        && request.resource.data.date == resource.data.date
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /usernames/{normalizedUsername} {
      allow read: if signedIn();
      allow create: if signedIn()
        && accountAvailableAfter(request.auth.uid)
        && !exists(/databases/$(database)/documents/usernames/$(normalizedUsername))
        && !isProtectedAdministrator(normalizedUsername)
        && !isProtectedAdministrator(request.resource.data.username)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
        && request.resource.data.username.lower() == normalizedUsername
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          == request.resource.data.username
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if activeUser()
        && resource.data.uid == request.auth.uid
        && (
          (exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
            && resource.data.username.lower() == normalizedUsername)
          ||
          (getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower()
            != normalizedUsername)
        );
    }

    match /pushSubscriptions/{subscriptionId} {
      allow get, list: if pushReadDeleteUser()
        && resource.data.uid == request.auth.uid;
      allow create: if activePushUserAfter()
        && validPushSubscriptionId(subscriptionId)
        && validPushSubscription()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if activePushUserAfter()
        && validPushSubscriptionId(subscriptionId)
        && resource.data.uid == request.auth.uid
        && validPushSubscription()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.endpoint == resource.data.endpoint
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'expirationTime', 'p256dh', 'auth', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if pushReadDeleteUser()
        && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && accountAvailableAfter(userId)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt', 'lastActiveAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
        && !isProtectedAdministrator(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActiveAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.username
          == request.resource.data.username
        && ((exists(/databases/$(database)/documents/system/accountStats)
          && getAfter(/databases/$(database)/documents/system/accountStats).data.count
            == get(/databases/$(database)/documents/system/accountStats).data.count + 1)
          || (!exists(/databases/$(database)/documents/system/accountStats)
            && getAfter(/databases/$(database)/documents/system/accountStats).data.count == 6));
      allow update: if validStandaloneAdminBan(userId)
        || validDeletionQueueProfile(userId)
        || (activeUserAfter()
          && request.auth.uid == userId
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
              && request.resource.data.lastActiveAt == request.time
              && (!resource.data.keys().hasAny(['lastActiveAt'])
                || (resource.data.lastActiveAt is timestamp
                  && request.time - resource.data.lastActiveAt >= duration.value(24, 'h'))))
            ||
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['profileImage', 'coverImage'])
              && request.resource.data.get('profileImage', '').size() <= 360000
              && request.resource.data.get('coverImage', '').size() <= 360000)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
              && (!isProtectedAdministrator(resource.data.username)
                || request.resource.data.username.lower() == resource.data.username.lower())
              && request.resource.data.username is string
              && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
              && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()))
              && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid
                == request.auth.uid)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spotifyTrackUrl'])
              && request.resource.data.get('spotifyTrackUrl', '') is string
              && request.resource.data.get('spotifyTrackUrl', '').size() <= 200
              && (request.resource.data.get('spotifyTrackUrl', '') == ''
                || request.resource.data.get('spotifyTrackUrl', '')
                  .matches('https://open[.]spotify[.]com/track/[A-Za-z0-9]{22}')))
          ));
      allow delete: if activeUser()
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
          && !isProtectedAdministrator(resource.data.username);
    }

    match /adminDeletionJobs/{targetUid} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && !isProtectedAdministrator(
          get(/databases/$(database)/documents/users/$(targetUid)).data.username
        )
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(targetUid))
        && matchingDeletionQueueJob(request.resource.data, targetUid)
        && existsAfter(/databases/$(database)/documents/users/$(targetUid))
        && hasNoDeletionQueueState(
          get(/databases/$(database)/documents/users/$(targetUid)).data
        )
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data
          .diff(get(/databases/$(database)/documents/users/$(targetUid)).data)
          .affectedKeys().hasOnly([
            'banned', 'adminDeletionRequestedAt', 'adminDeletionRequestedBy', 'adminDeletionStatus'
          ])
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.banned == true
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.adminDeletionRequestedAt
          == request.time
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.adminDeletionRequestedBy
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.adminDeletionStatus
          == 'queued';
      allow update, delete: if false;
    }

    match /accountDeletionRequests/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if activeUserAfter()
        && request.auth.uid == userId
        && !isProtectedAdministrator(currentUsername())
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /blocks/{blockKey} {
      allow read: if activeUser()
        && (resource.data.blockerId == request.auth.uid
          || resource.data.blockedId == request.auth.uid);
      allow create: if activeUserAfter() && validBlock(blockKey);
      allow update: if false;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
    }

    match /reports/{reportKey} {
      allow read: if isAdmin();
      allow create: if validReportCreate(reportKey);
      allow update: if validReportResolution(reportKey);
      allow delete: if validResolvedReportDelete(reportKey);
    }

    match /moderationActions/{actionKey} {
      allow read: if isAdmin();
      allow create, update: if validModerationAction(actionKey);
      allow delete: if false;
    }

    match /moderationDeletionJobs/{jobId} {
      allow read: if isAdmin();
      allow create: if validModerationDeletionQueue(jobId);
      allow update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && accountAvailableAfter(request.resource.data.followingId)
        && followId == request.auth.uid + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
    }

    match /notificationReads/{readId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if activeUserAfter()
        && readId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'readAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.eventId.matches('^event-[0-9a-f]{16}$')
        && request.resource.data.readAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /notificationEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, create, update, delete: if false;
    }

    match /{documentPath=**}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && contentAvailableAfter(documentPath)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    match /{documentPath=**}/reactions/{reactionId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && contentAvailableAfter(documentPath)
        && reactionId == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['heart', 'middle_finger', 'laugh', 'sad']
        && request.resource.data.createdAt == request.time;
      allow update: if activeUserAfter()
        && contentAvailableAfter(documentPath)
        && reactionId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['heart', 'middle_finger', 'laugh', 'sad']
        && request.resource.data.createdAt == request.time;
      allow delete: if (signedIn()
          && reactionId == request.auth.uid
          && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    function acceptedChat(otherId) {
      return (exists(/databases/$(database)/documents/messageRequests/$(request.auth.uid + '_' + otherId))
          && get(/databases/$(database)/documents/messageRequests/$(request.auth.uid + '_' + otherId)).data.status == 'accepted')
        || (exists(/databases/$(database)/documents/messageRequests/$(otherId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/messageRequests/$(otherId + '_' + request.auth.uid)).data.status == 'accepted');
    }

    function mutualReveal(otherId) {
      return exists(/databases/$(database)/documents/reveals/$(request.auth.uid + '_' + otherId))
        && exists(/databases/$(database)/documents/reveals/$(otherId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/reveals/$(request.auth.uid + '_' + otherId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/reveals/$(otherId + '_' + request.auth.uid)).data.status == 'accepted';
    }

    match /userPrivate/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || mutualReveal(userId));
      allow create, update: if activeUserAfter()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'interests', 'region', 'ageRange', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.interests is string
        && request.resource.data.interests.size() <= 100
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 60
        && request.resource.data.ageRange is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /userPreferences/{userId} {
      allow read: if activeUser() && request.auth.uid == userId;
      allow create, update: if activeUserAfter() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'mutedKeywords', 'contextCheck', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mutedKeywords is list
        && request.resource.data.mutedKeywords.size() <= 20
        && request.resource.data.contextCheck is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /circles/{circleId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 180
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (activeUser() && resource.data.ownerId == request.auth.uid);
    }

    match /circleMembers/{memberId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && memberId == request.resource.data.circleId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['circleId', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && circleAvailableAfter(request.resource.data.circleId)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityPosts/{postId} {
      allow get: if signedIn()
        && (moderationTargetActive(resource.data) || isAdmin());
      allow list: if signedIn()
        && (resource.data.moderationStatus == 'active' || isAdmin());
      allow create: if activeUserAfter()
        && noModerationDeletionJobAfter('communityPost', postId)
        && request.resource.data.keys().hasOnly([
          'authorId', 'username', 'content', 'category', 'circleId', 'options',
          'moderationStatus', 'expiresAt', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['moderationStatus'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.moderationStatus == 'active'
        && request.resource.data.username == currentUsername()
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 500
        && request.resource.data.category in ['Question', 'Confession', 'Advice', 'Rant', 'Good News', 'Poll']
        && request.resource.data.circleId is string
        && circleAvailableAfter(request.resource.data.circleId)
        && request.resource.data.options is list
        && request.resource.data.options.size() <= 4
        && request.resource.data.createdAt == request.time;
      allow update: if validCommunityPostReportHold(postId)
        || validCommunityPostRestore(postId);
      allow delete: if (isAdmin()
          && (moderationTargetActive(resource.data)
            || validReportedTargetDelete('communityPost', postId)))
        || (signedIn()
          && moderationTargetActive(resource.data)
          && resource.data.authorId == request.auth.uid);
    }

    match /communityVotes/{voteId} {
      allow read: if signedIn();
      allow create, update: if activeUserAfter()
        && request.resource.data.postCollection in ['posts', 'communityPosts']
        && ((request.resource.data.postCollection == 'posts'
            && existsAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId))
            && linkedContentAvailableAfter(getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data))
          || (request.resource.data.postCollection == 'communityPosts'
            && existsAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
            && linkedContentAvailableAfter(getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data)))
        && voteId == request.resource.data.postCollection + '_' + request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['postCollection', 'postId', 'uid', 'option', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.option is int
        && request.resource.data.option >= 0
        && request.resource.data.option <= 3
        && request.resource.data.createdAt == request.time;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    match /rooms/{roomId} {
      allow get: if signedIn()
        && (moderationTargetActive(resource.data) || isAdmin());
      allow list: if signedIn()
        && (resource.data.moderationStatus == 'active' || isAdmin());
      allow create: if activeUserAfter()
        && noModerationDeletionJobAfter('room', roomId)
        && request.resource.data.keys().hasOnly([
          'name', 'topic', 'ownerId', 'moderationStatus', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['moderationStatus'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.moderationStatus == 'active'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if validRoomReportHold(roomId) || validRoomRestore(roomId);
      allow delete: if (isAdmin()
          && (moderationTargetActive(resource.data)
            || validReportedTargetDelete('room', roomId)))
        || (signedIn()
          && moderationTargetActive(resource.data)
          && resource.data.ownerId == request.auth.uid);
    }

    match /roomMembers/{memberId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if activeUserAfter()
        && memberId == request.resource.data.roomId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['roomId', 'uid', 'joinedAt'])
        && request.resource.data.uid == request.auth.uid
        && roomAvailableAfter(request.resource.data.roomId)
        && request.resource.data.joinedAt == request.time;
      allow update: if activeUserAfter()
        && roomAvailableAfter(request.resource.data.roomId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedAt'])
        && request.resource.data.joinedAt == request.time;
      allow delete: if signedIn()
        && ((resource.data.uid == request.auth.uid
            && roomEvidenceMayBeRemoved(resource.data.roomId))
          || (isAdmin()
            && !existsAfter(/databases/$(database)/documents/rooms/$(resource.data.roomId))
            && validCurrentActionForTarget(
              'room', resource.data.roomId, 'delete-room'
            )));
    }

    match /roomMessages/{messageId} {
      allow get, list: if signedIn() && roomEvidenceReadable(resource.data.roomId);
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['roomId', 'senderId', 'tempName', 'text', 'expiresAt', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && roomAvailableAfter(request.resource.data.roomId)
        && request.resource.data.tempName is string
        && request.resource.data.tempName.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if (isAdmin() && roomEvidenceMayBeRemoved(resource.data.roomId))
        || (signedIn()
          && resource.data.senderId == request.auth.uid
          && roomEvidenceMayBeRemoved(resource.data.roomId));
    }

    match /messageRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if activeUserAfter()
        && accountAvailableAfter(request.resource.data.toId)
        && request.resource.data.keys().hasOnly(['fromId', 'toId', 'status', 'createdAt'])
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.status == 'pending'
        && (requestId == request.resource.data.fromId + '_' + request.resource.data.toId
          || requestId == request.resource.data.toId + '_' + request.resource.data.fromId)
        && request.resource.data.createdAt == request.time;
      allow update: if activeUserAfter()
        && accountAvailableAfter(request.resource.data.fromId)
        && accountAvailableAfter(request.resource.data.toId)
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
            && resource.data.toId == request.auth.uid
            && request.resource.data.status in ['accepted', 'declined'])
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
            && resource.data.fromId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.status == 'pending')
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fromId', 'toId', 'status', 'createdAt'])
            && resource.data.status == 'declined'
            && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid)
            && request.resource.data.fromId == request.auth.uid
            && request.resource.data.toId == (resource.data.fromId == request.auth.uid
              ? resource.data.toId : resource.data.fromId)
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time)
        )
        && (!request.resource.data.keys().hasAny(['respondedAt'])
          || request.resource.data.respondedAt == resource.data.get('respondedAt', null)
          || request.resource.data.respondedAt == request.time);
      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /directMessages/{messageId} {
      allow read: if activeUser() && request.auth.uid in resource.data.participants;
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['participants', 'senderId', 'text', 'createdAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && accountAvailableAfter(request.resource.data.participants[0])
        && accountAvailableAfter(request.resource.data.participants[1])
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.senderId == request.auth.uid
        && acceptedChat(request.resource.data.participants[0] == request.auth.uid
          ? request.resource.data.participants[1] : request.resource.data.participants[0])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /reveals/{revealId} {
      allow read: if activeUser()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['fromId', 'toId', 'fields', 'status', 'createdAt'])
        && request.resource.data.fromId == request.auth.uid
        && accountAvailableAfter(request.resource.data.toId)
        && acceptedChat(request.resource.data.toId)
        && request.resource.data.fields.keys().hasOnly(['interests', 'region', 'ageRange'])
        && request.resource.data.status == 'pending'
        && revealId == request.auth.uid + '_' + request.resource.data.toId
        && request.resource.data.createdAt == request.time;
      allow update: if activeUserAfter()
        && accountAvailableAfter(resource.data.fromId)
        && accountAvailableAfter(resource.data.toId)
        && resource.data.toId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.respondedAt == request.time;
      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /posts/{postId}/comments/{commentId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    match /communityPosts/{postId}/comments/{commentId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId == request.auth.uid;
    }

    match /posts/{postId}/reactions/{reactionId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    match /posts/{postId} {
      allow get: if signedIn()
        && (moderationTargetActive(resource.data) || isAdmin());
      allow list: if signedIn()
        && (resource.data.moderationStatus == 'active' || isAdmin());
      allow create: if activeUserAfter()
        && noModerationDeletionJobAfter('post', postId)
        && (validOriginalPost() || validRepost(postId));
      allow update: if validPostReportHold(postId) || validPostRestore(postId);
      allow delete: if (isAdmin()
          && (moderationTargetActive(resource.data)
            || validReportedTargetDelete('post', postId)))
        || (signedIn()
          && moderationTargetActive(resource.data)
          && resource.data.authorId == request.auth.uid);
    }
  }
}
