rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower()
          in ['i_love_you_h', 'ownercybercapone'];
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true;
    }

    function currentUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function validOriginalPost() {
      return request.resource.data.keys().hasOnly(['type', 'authorId', 'username', 'content', 'imageData', 'category', 'options', 'expiresAt', 'createdAt'])
        && request.resource.data.type == 'original'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 500
        && (request.resource.data.content.size() >= 1
          || request.resource.data.get('imageData', '').size() > 0)
        && request.resource.data.get('imageData', '').size() <= 800000
        && request.resource.data.get('category', 'Post') in ['Post', 'Question', 'Confession', 'Advice', 'Rant', 'Good News', 'Poll']
        && request.resource.data.get('options', []) is list
        && request.resource.data.get('options', []).size() <= 4
        && (request.resource.data.get('category', 'Post') != 'Poll'
          || request.resource.data.get('options', []).size() >= 2)
        && (request.resource.data.get('expiresAt', null) == null
          || (request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time))
        && request.resource.data.createdAt == request.time;
    }

    function validRepost(postId) {
      let original = get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId));
      return request.resource.data.keys().hasOnly([
          'type', 'authorId', 'username', 'originalPostId',
          'originalAuthorId', 'originalUsername', 'content', 'imageData', 'createdAt'
        ])
        && request.resource.data.type == 'repost'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.username == currentUsername()
        && postId == 'repost_' + request.auth.uid + '_' + request.resource.data.originalPostId
        && original.data.type == 'original'
        && request.resource.data.originalAuthorId == original.data.authorId
        && request.resource.data.originalUsername == original.data.username
        && request.resource.data.content == original.data.content
        && request.resource.data.get('imageData', '') == original.data.get('imageData', '')
        && request.resource.data.createdAt == request.time;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system/accountStats {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'limit', 'updatedAt'])
        && request.resource.data.limit == 500
        && request.resource.data.updatedAt == request.time
        && ((activeUser() && request.resource.data.count == 5)
          || (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            && request.resource.data.count == 6));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'limit', 'updatedAt'])
        && request.resource.data.limit == 500
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= request.resource.data.limit
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)))
          ||
          (request.resource.data.count == resource.data.count - 1
            && request.resource.data.count >= 0
            && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)))
        );
      allow delete: if false;
    }

    match /pageViews/{day} {
      allow read: if isAdmin();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['date', 'views', 'updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.views == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if activeUser()
        && request.resource.data.keys().hasOnly(['date', 'views', 'updatedAt'])
        && request.resource.data.date == resource.data.date
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /usernames/{normalizedUsername} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(normalizedUsername))
        && !(normalizedUsername in ['i_love_you_h', 'ownercybercapone'])
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
        && request.resource.data.username.lower() == normalizedUsername
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if activeUser()
        && resource.data.uid == request.auth.uid
        && (
          (exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
            && resource.data.username.lower() == normalizedUsername)
          ||
          (getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower()
            != normalizedUsername)
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
        && request.resource.data.createdAt == request.time
        && ((exists(/databases/$(database)/documents/system/accountStats)
          && getAfter(/databases/$(database)/documents/system/accountStats).data.count
            == get(/databases/$(database)/documents/system/accountStats).data.count + 1)
          || (!exists(/databases/$(database)/documents/system/accountStats)
            && getAfter(/databases/$(database)/documents/system/accountStats).data.count == 6));
      allow update: if isAdmin()
        || (activeUser()
          && request.auth.uid == userId
          && (
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['profileImage', 'coverImage'])
              && request.resource.data.get('profileImage', '').size() <= 360000
              && request.resource.data.get('coverImage', '').size() <= 360000)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
              && (!(resource.data.username.lower() in ['i_love_you_h', 'ownercybercapone'])
                || request.resource.data.username.lower() == resource.data.username.lower())
              && request.resource.data.username is string
              && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
              && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()))
              && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid
                == request.auth.uid)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spotifyTrackUrl'])
              && request.resource.data.get('spotifyTrackUrl', '') is string
              && request.resource.data.get('spotifyTrackUrl', '').size() <= 200
              && (request.resource.data.get('spotifyTrackUrl', '') == ''
                || request.resource.data.get('spotifyTrackUrl', '')
                  .matches('https://open[.]spotify[.]com/track/[A-Za-z0-9]{22}')))
          ));
      allow delete: if isAdmin()
        || (activeUser()
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
          && !(resource.data.username.lower() in ['i_love_you_h', 'ownercybercapone']));
    }

    match /accountDeletionRequests/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if activeUser()
        && request.auth.uid == userId
        && !(currentUsername().lower() in ['i_love_you_h', 'ownercybercapone'])
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followingId))
        && followId == request.auth.uid + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
    }

    match /notificationReads/{readId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && readId == request.auth.uid + '_' + request.resource.data.reactionId
        && request.resource.data.keys().hasOnly(['uid', 'reactionId', 'readAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reactionId is string
        && request.resource.data.readAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{documentPath=**}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    match /{documentPath=**}/reactions/{reactionId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && reactionId == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['heart', 'middle_finger', 'laugh', 'sad']
        && request.resource.data.createdAt == request.time;
      allow update: if activeUser()
        && reactionId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['heart', 'middle_finger', 'laugh', 'sad']
        && request.resource.data.createdAt == request.time;
      allow delete: if (signedIn()
          && reactionId == request.auth.uid
          && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    function acceptedChat(otherId) {
      return (exists(/databases/$(database)/documents/messageRequests/$(request.auth.uid + '_' + otherId))
          && get(/databases/$(database)/documents/messageRequests/$(request.auth.uid + '_' + otherId)).data.status == 'accepted')
        || (exists(/databases/$(database)/documents/messageRequests/$(otherId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/messageRequests/$(otherId + '_' + request.auth.uid)).data.status == 'accepted');
    }

    function mutualReveal(otherId) {
      return exists(/databases/$(database)/documents/reveals/$(request.auth.uid + '_' + otherId))
        && exists(/databases/$(database)/documents/reveals/$(otherId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/reveals/$(request.auth.uid + '_' + otherId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/reveals/$(otherId + '_' + request.auth.uid)).data.status == 'accepted';
    }

    match /userPrivate/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || mutualReveal(userId));
      allow create, update: if activeUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'interests', 'region', 'ageRange', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.interests is string
        && request.resource.data.interests.size() <= 100
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 60
        && request.resource.data.ageRange is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /userPreferences/{userId} {
      allow read: if activeUser() && request.auth.uid == userId;
      allow create, update: if activeUser() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'mutedKeywords', 'contextCheck', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mutedKeywords is list
        && request.resource.data.mutedKeywords.size() <= 20
        && request.resource.data.contextCheck is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /circles/{circleId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 180
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (activeUser() && resource.data.ownerId == request.auth.uid);
    }

    match /circleMembers/{memberId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && memberId == request.resource.data.circleId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['circleId', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/circles/$(request.resource.data.circleId))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['authorId', 'username', 'content', 'category', 'circleId', 'options', 'expiresAt', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 500
        && request.resource.data.category in ['Question', 'Confession', 'Advice', 'Rant', 'Good News', 'Poll']
        && request.resource.data.circleId is string
        && request.resource.data.options is list
        && request.resource.data.options.size() <= 4
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /communityVotes/{voteId} {
      allow read: if signedIn();
      allow create, update: if activeUser()
        && voteId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['postId', 'uid', 'option', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.option is int
        && request.resource.data.option >= 0
        && request.resource.data.option <= 3
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['name', 'topic', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /roomMembers/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if activeUser()
        && memberId == request.resource.data.roomId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['roomId', 'uid', 'joinedAt'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && request.resource.data.joinedAt == request.time;
      allow update: if activeUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedAt'])
        && request.resource.data.joinedAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /roomMessages/{messageId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['roomId', 'senderId', 'tempName', 'text', 'expiresAt', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && request.resource.data.tempName is string
        && request.resource.data.tempName.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.senderId == request.auth.uid);
    }

    match /messageRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['fromId', 'toId', 'status', 'createdAt'])
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.status == 'pending'
        && (requestId == request.resource.data.fromId + '_' + request.resource.data.toId
          || requestId == request.resource.data.toId + '_' + request.resource.data.fromId)
        && request.resource.data.createdAt == request.time;
      allow update: if activeUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && (
          (resource.data.toId == request.auth.uid
            && request.resource.data.status in ['accepted', 'declined'])
          ||
          (resource.data.fromId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.status == 'pending')
        )
        && (!request.resource.data.keys().hasAny(['respondedAt'])
          || request.resource.data.respondedAt == resource.data.get('respondedAt', null)
          || request.resource.data.respondedAt == request.time);
      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /directMessages/{messageId} {
      allow read: if activeUser() && request.auth.uid in resource.data.participants;
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['participants', 'senderId', 'text', 'createdAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.senderId == request.auth.uid
        && acceptedChat(request.resource.data.participants[0] == request.auth.uid
          ? request.resource.data.participants[1] : request.resource.data.participants[0])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /reveals/{revealId} {
      allow read: if activeUser()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['fromId', 'toId', 'fields', 'status', 'createdAt'])
        && request.resource.data.fromId == request.auth.uid
        && acceptedChat(request.resource.data.toId)
        && request.resource.data.fields.keys().hasOnly(['interests', 'region', 'ageRange'])
        && request.resource.data.status == 'pending'
        && revealId == request.auth.uid + '_' + request.resource.data.toId
        && request.resource.data.createdAt == request.time;
      allow update: if activeUser()
        && resource.data.toId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.respondedAt == request.time;
      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /posts/{postId}/comments/{commentId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    match /communityPosts/{postId}/comments/{commentId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId == request.auth.uid;
    }

    match /posts/{postId}/reactions/{reactionId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if activeUser() && (validOriginalPost() || validRepost(postId));
      allow update: if false;
      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }
  }
}
