rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountAvailable(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/users/$(uid))
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(uid));
    }

    function accountAvailableAfter(uid) {
      return uid is string
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(uid));
    }

    function hasNoDeletionBarrierAfter(uid) {
      return uid is string
        && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(uid));
    }

    function activeUserAfter() {
      return signedIn()
        && accountAvailableAfter(request.auth.uid)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true;
    }

    function contentAvailableAfter(documentPath) {
      return existsAfter(/databases/$(database)/documents/$(documentPath))
        && getAfter(/databases/$(database)/documents/$(documentPath)).data
          .get('moderationState', 'visible') != 'hidden'
        && linkedContentAvailableAfter(
          getAfter(/databases/$(database)/documents/$(documentPath)).data
        );
    }

    function linkedContentAvailableAfter(content) {
      return content.keys().hasAny(['authorId', 'originalAuthorId', 'ownerId', 'senderId'])
        && (!content.keys().hasAny(['authorId']) || hasNoDeletionBarrierAfter(content.authorId))
        && (!content.keys().hasAny(['originalAuthorId'])
          || hasNoDeletionBarrierAfter(content.originalAuthorId))
        && (!content.keys().hasAny(['ownerId']) || hasNoDeletionBarrierAfter(content.ownerId))
        && (!content.keys().hasAny(['senderId']) || hasNoDeletionBarrierAfter(content.senderId))
        && (!content.keys().hasAny(['circleId']) || linkedCircleAvailableAfter(content.circleId))
        && (!content.keys().hasAny(['roomId']) || linkedRoomAvailableAfter(content.roomId));
    }

    function votePostAvailableAfter(postCollection, postId) {
      return (postCollection == 'posts'
          && existsAfter(/databases/$(database)/documents/posts/$(postId))
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data
            .get('moderationState', 'visible') != 'hidden'
          && linkedContentAvailableAfter(
            getAfter(/databases/$(database)/documents/posts/$(postId)).data
          ))
        || (postCollection == 'communityPosts'
          && existsAfter(/databases/$(database)/documents/communityPosts/$(postId))
          && getAfter(/databases/$(database)/documents/communityPosts/$(postId)).data
            .get('moderationState', 'visible') != 'hidden'
          && linkedContentAvailableAfter(
            getAfter(/databases/$(database)/documents/communityPosts/$(postId)).data
          ));
    }

    function circleAvailableAfter(circleId) {
      return existsAfter(/databases/$(database)/documents/circles/$(circleId))
        && accountAvailableAfter(getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId);
    }

    function roomAvailableAfter(roomId) {
      return existsAfter(/databases/$(database)/documents/rooms/$(roomId))
        && accountAvailableAfter(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId)
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data
          .get('moderationState', 'visible') != 'hidden'
        && roomIsActive(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data);
    }

    function linkedCircleAvailableAfter(circleId) {
      return existsAfter(/databases/$(database)/documents/circles/$(circleId))
        && hasNoDeletionBarrierAfter(getAfter(/databases/$(database)/documents/circles/$(circleId)).data.ownerId);
    }

    function linkedRoomAvailableAfter(roomId) {
      return existsAfter(/databases/$(database)/documents/rooms/$(roomId))
        && hasNoDeletionBarrierAfter(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId)
        && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data
          .get('moderationState', 'visible') != 'hidden'
        && roomIsActive(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data);
    }

    function linkedRoomAvailable(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId))
        && hasNoDeletionBarrierAfter(get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId)
        && get(/databases/$(database)/documents/rooms/$(roomId)).data
          .get('moderationState', 'visible') != 'hidden'
        && roomIsActive(get(/databases/$(database)/documents/rooms/$(roomId)).data);
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        && hasMatchingAdminReservation(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        );
    }

    function blockPath(left, right) {
      return /databases/$(database)/documents/blocks/$(left + '_' + right);
    }

    function pairIsBlocked(left, right) {
      return exists(blockPath(left, right)) || exists(blockPath(right, left));
    }

    function visibleOrAdmin() {
      return isAdmin() || resource.data.get('moderationState', 'visible') != 'hidden';
    }

    function visibleContentOrAdmin(documentPath) {
      return isAdmin()
        || (exists(/databases/$(database)/documents/$(documentPath))
          && get(/databases/$(database)/documents/$(documentPath)).data
            .get('moderationState', 'visible') != 'hidden');
    }

    function votePostVisible(postCollection, postId) {
      return (postCollection == 'posts'
          && exists(/databases/$(database)/documents/posts/$(postId))
          && get(/databases/$(database)/documents/posts/$(postId)).data
            .get('moderationState', 'visible') != 'hidden')
        || (postCollection == 'communityPosts'
          && exists(/databases/$(database)/documents/communityPosts/$(postId))
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data
            .get('moderationState', 'visible') != 'hidden');
    }

    function legacyVoteTargetIsUnambiguous(postId) {
      return (exists(/databases/$(database)/documents/posts/$(postId))
          && !exists(/databases/$(database)/documents/communityPosts/$(postId)))
        || (!exists(/databases/$(database)/documents/posts/$(postId))
          && exists(/databases/$(database)/documents/communityPosts/$(postId)));
    }

    function communityVoteVisibleOrAdmin() {
      return isAdmin()
        || (resource.data.keys().hasAll(['postCollection'])
          && votePostVisible(resource.data.postCollection, resource.data.postId))
        || (!resource.data.keys().hasAny(['postCollection', 'legacyMigrationState'])
          && legacyVoteTargetIsUnambiguous(resource.data.postId)
          && (votePostVisible('posts', resource.data.postId)
            || votePostVisible('communityPosts', resource.data.postId)));
    }

    function roomIsActive(room) {
      return room.expiresAt is timestamp && room.expiresAt > request.time;
    }

    function validRoomExpiry() {
      return request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt >= request.time + duration.value(23, 'h')
          + duration.value(55, 'm')
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')
          + duration.value(5, 'm');
    }

    function validRoomMessageExpiry(roomId) {
      return (getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.keys()
          .hasAny(['expiresAt'])
          && request.resource.data.expiresAt
            == getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.expiresAt)
        || (!getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.keys()
          .hasAny(['expiresAt'])
          && !request.resource.data.keys().hasAny(['expiresAt']));
    }

    function validReportTarget() {
      return (request.resource.data.targetKind == 'post'
          && request.resource.data.targetCollection == 'posts'
          && request.resource.data.targetPath == 'posts/' + request.resource.data.targetId
          && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId))
          && get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.authorId
            == request.resource.data.reportedUserId)
        || (request.resource.data.targetKind == 'communityPost'
          && request.resource.data.targetCollection == 'communityPosts'
          && request.resource.data.targetPath == 'communityPosts/' + request.resource.data.targetId
          && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.targetId))
          && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.targetId)).data.authorId
            == request.resource.data.reportedUserId)
        || (request.resource.data.targetKind == 'room'
          && request.resource.data.targetCollection == 'rooms'
          && request.resource.data.targetPath == 'rooms/' + request.resource.data.targetId
          && exists(/databases/$(database)/documents/rooms/$(request.resource.data.targetId))
          && get(/databases/$(database)/documents/rooms/$(request.resource.data.targetId)).data.ownerId
            == request.resource.data.reportedUserId
          && get(/databases/$(database)/documents/rooms/$(request.resource.data.targetId)).data
            .get('moderationState', 'visible') != 'hidden'
          && get(/databases/$(database)/documents/rooms/$(request.resource.data.targetId)).data
            .get('cleanupState', 'open') != 'closing'
          && roomIsActive(get(/databases/$(database)/documents/rooms/$(request.resource.data.targetId)).data))
        || (request.resource.data.targetKind == 'roomMessage'
          && request.resource.data.targetCollection == 'roomMessages'
          && request.resource.data.targetPath == 'roomMessages/' + request.resource.data.targetId
          && exists(/databases/$(database)/documents/roomMessages/$(request.resource.data.targetId))
          && get(/databases/$(database)/documents/roomMessages/$(request.resource.data.targetId)).data.senderId
            == request.resource.data.reportedUserId
          && exists(/databases/$(database)/documents/rooms/$(get(/databases/$(database)/documents/roomMessages/$(request.resource.data.targetId)).data.roomId))
          && get(/databases/$(database)/documents/rooms/$(get(/databases/$(database)/documents/roomMessages/$(request.resource.data.targetId)).data.roomId)).data.get('cleanupState', 'open') != 'closing')
        || (request.resource.data.targetKind == 'user'
          && request.resource.data.targetCollection == 'users'
          && request.resource.data.targetId == request.resource.data.reportedUserId
          && request.resource.data.targetPath == 'users/' + request.resource.data.targetId
          && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId)));
    }

    function reportReceiptTargetExists(targetKind, targetId) {
      return (targetKind == 'post'
          && exists(/databases/$(database)/documents/posts/$(targetId)))
        || (targetKind == 'communityPost'
          && exists(/databases/$(database)/documents/communityPosts/$(targetId)))
        || (targetKind == 'room'
          && exists(/databases/$(database)/documents/rooms/$(targetId)))
        || (targetKind == 'roomMessage'
          && exists(/databases/$(database)/documents/roomMessages/$(targetId)))
        || (targetKind == 'user'
          && exists(/databases/$(database)/documents/users/$(targetId)));
    }

    function exactReceiptAfterIntake() {
      let receipt = getAfter(/databases/$(database)/documents/reportReceipts/$(request.auth.uid)/$(request.resource.data.targetKind)/$(request.resource.data.targetId));
      return !exists(/databases/$(database)/documents/reportReceipts/$(request.auth.uid)/$(request.resource.data.targetKind)/$(request.resource.data.targetId))
        && existsAfter(/databases/$(database)/documents/reportReceipts/$(request.auth.uid)/$(request.resource.data.targetKind)/$(request.resource.data.targetId))
        && receipt.data.keys().hasOnly(['reporterUid', 'targetKind', 'targetId', 'createdAt'])
        && receipt.data.reporterUid == request.auth.uid
        && receipt.data.targetKind == request.resource.data.targetKind
        && receipt.data.targetId == request.resource.data.targetId
        && receipt.data.createdAt == request.resource.data.createdAt;
    }

    function exactIntakeAfterReceipt(reporterUid, targetKind, targetId) {
      let intake = getAfter(/databases/$(database)/documents/reportIntakes/$(reporterUid + '_' + targetKind + '_' + targetId));
      return !exists(/databases/$(database)/documents/reportIntakes/$(reporterUid + '_' + targetKind + '_' + targetId))
        && existsAfter(/databases/$(database)/documents/reportIntakes/$(reporterUid + '_' + targetKind + '_' + targetId))
        && intake.data.reporterUid == reporterUid
        && intake.data.targetKind == targetKind
        && intake.data.targetId == targetId
        && intake.data.createdAt == request.resource.data.createdAt;
    }

    function exactMaterialHoldAfter(reportId) {
      let kind = request.resource.data.targetKind;
      let targetId = request.resource.data.targetId;
      let postAfter = getAfter(/databases/$(database)/documents/posts/$(targetId));
      let communityAfter = getAfter(/databases/$(database)/documents/communityPosts/$(targetId));
      let roomAfter = getAfter(/databases/$(database)/documents/rooms/$(targetId));
      return (kind == 'post'
          && postAfter.data.get('moderationState', 'visible') == 'hidden'
          && postAfter.data.moderationHoldId == reportId
          && postAfter.data.moderationHeldAt == request.time)
        || (kind == 'communityPost'
          && communityAfter.data.get('moderationState', 'visible') == 'hidden'
          && communityAfter.data.moderationHoldId == reportId
          && communityAfter.data.moderationHeldAt == request.time)
        || (kind == 'room'
          && roomAfter.data.get('moderationState', 'visible') == 'hidden'
          && roomAfter.data.moderationHoldId == reportId
          && roomAfter.data.moderationHeldAt == request.time)
        || kind in ['roomMessage', 'user'];
    }

    function validAdminMaterialRestore() {
      return isAdmin()
        && resource.data.get('moderationState', 'visible') == 'hidden'
        && request.resource.data.get('moderationState', 'visible') == 'visible'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationState']);
    }

    function validModerationHoldUpdate(targetKind, targetId, reportedUserId) {
      let reportId = request.auth.uid + '_' + targetKind + '_' + targetId;
      let intake = getAfter(/databases/$(database)/documents/reportIntakes/$(reportId));
      return activeUserAfter()
        && resource.data.get('moderationState', 'visible') != 'hidden'
        && request.resource.data.get('moderationState', 'visible') == 'hidden'
        && request.resource.data.moderationHoldId == reportId
        && request.resource.data.moderationHeldAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['moderationState', 'moderationHoldId', 'moderationHeldAt'])
        && !exists(/databases/$(database)/documents/reportIntakes/$(reportId))
        && existsAfter(/databases/$(database)/documents/reportIntakes/$(reportId))
        && intake.data.reporterUid == request.auth.uid
        && intake.data.targetKind == targetKind
        && intake.data.targetId == targetId
        && intake.data.reportedUserId == reportedUserId
        && intake.data.createdAt == request.time;
    }

    function validReportIntake(reportId) {
      return request.resource.data.keys().hasOnly([
          'reporterUid', 'targetKind', 'targetCollection', 'targetId', 'targetPath',
          'reportedUserId', 'reason', 'createdAt', 'status'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && !request.resource.data.targetId.matches('.*[/].*')
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId.size() > 0
        && request.resource.data.reporterUid != request.resource.data.reportedUserId
        && reportId == request.auth.uid + '_' + request.resource.data.targetKind + '_'
          + request.resource.data.targetId
        && request.resource.data.targetKind in ['post', 'communityPost', 'room', 'roomMessage', 'user']
        && request.resource.data.reason in [
          'harassment', 'hate-threats', 'sexual-content', 'spam-scam',
          'privacy-impersonation', 'other'
        ]
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'queued'
        && validReportTarget()
        && exactMaterialHoldAfter(reportId);
    }

    function validQueuedModerationAction(caseId) {
      return existsAfter(/databases/$(database)/documents/moderationCases/$(caseId))
        && request.resource.data.keys().hasOnly([
          'action', 'requestedAt', 'requestedBy', 'status'
        ])
        && request.resource.data.action in ['restore', 'deleteMaterial']
        && request.resource.data.requestedAt == request.time
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'queued';
    }

    function validImmediateReportCase(caseId) {
      let intakeId = request.auth.uid + '_' + request.resource.data.targetKind + '_'
        + request.resource.data.targetId;
      let intake = getAfter(/databases/$(database)/documents/reportIntakes/$(intakeId));
      return activeUserAfter()
        && request.resource.data.keys().hasOnly([
          'targetKind', 'targetCollection', 'targetId', 'targetPath', 'reportedUserId',
          'snapshot', 'status', 'reportCount', 'reasonTotals', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.targetKind in ['post', 'communityPost']
        && caseId == request.resource.data.targetKind + '_' + request.resource.data.targetId
        && existsAfter(/databases/$(database)/documents/reportIntakes/$(intakeId))
        && !exists(/databases/$(database)/documents/reportIntakes/$(intakeId))
        && intake.data.reporterUid == request.auth.uid
        && intake.data.targetKind == request.resource.data.targetKind
        && intake.data.targetCollection == request.resource.data.targetCollection
        && intake.data.targetId == request.resource.data.targetId
        && intake.data.reportedUserId == request.resource.data.reportedUserId
        && intake.data.createdAt == request.time
        && request.resource.data.targetPath
          == request.resource.data.targetCollection + '/' + request.resource.data.targetId
        && request.resource.data.snapshot.keys()
          .hasOnly(['kind', 'authorId', 'authorName', 'text'])
        && request.resource.data.snapshot.kind == request.resource.data.targetKind
        && request.resource.data.snapshot.authorId == request.resource.data.reportedUserId
        && request.resource.data.snapshot.authorName is string
        && request.resource.data.snapshot.authorName.size() <= 100
        && request.resource.data.snapshot.text is string
        && request.resource.data.snapshot.text.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.reportCount == 1
        && request.resource.data.reasonTotals.keys().hasOnly([intake.data.reason])
        && request.resource.data.reasonTotals.get(intake.data.reason, 0) == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAdminDeletionCase(caseId) {
      return isAdmin()
        && request.resource.data.keys().hasOnly([
          'targetKind', 'targetCollection', 'targetId', 'targetPath', 'reportedUserId',
          'snapshot', 'status', 'reportCount', 'reasonTotals', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.targetKind in ['post', 'communityPost']
        && caseId == request.resource.data.targetKind + '_' + request.resource.data.targetId
        && request.resource.data.targetCollection == (request.resource.data.targetKind == 'post' ? 'posts' : 'communityPosts')
        && request.resource.data.targetPath == request.resource.data.targetCollection + '/' + request.resource.data.targetId
        && exists(/databases/$(database)/documents/$(request.resource.data.targetCollection)/$(request.resource.data.targetId))
        && get(/databases/$(database)/documents/$(request.resource.data.targetCollection)/$(request.resource.data.targetId)).data.authorId
          == request.resource.data.reportedUserId
        && request.resource.data.snapshot.keys().hasOnly(['kind'])
        && request.resource.data.snapshot.kind == 'queuedAdminDeletion'
        && request.resource.data.status == 'deleteQueued'
        && request.resource.data.reportCount == 0
        && request.resource.data.reasonTotals == {}
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/moderationActions/$(caseId))
        && getAfter(/databases/$(database)/documents/moderationActions/$(caseId)).data.action == 'deleteMaterial'
        && getAfter(/databases/$(database)/documents/moderationActions/$(caseId)).data.requestedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/moderationActions/$(caseId)).data.requestedAt == request.time
        && getAfter(/databases/$(database)/documents/moderationActions/$(caseId)).data.status == 'queued';
    }

    function validTerminalModerationActionRetry(caseId) {
      return exists(/databases/$(database)/documents/moderationCases/$(caseId))
        && resource.data.status in ['failed', 'terminal']
        && resource.data.attempts is int
        && resource.data.attempts >= 8
        && request.resource.data.keys().hasOnly([
          'action', 'requestedAt', 'requestedBy', 'status'
        ])
        && request.resource.data.action == resource.data.action
        && request.resource.data.requestedAt == request.time
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.status == 'queued';
    }

    function validLegacyRoomAction() {
      return request.resource.data.keys().hasOnly([
          'roomId', 'action', 'requestedAt', 'requestedBy', 'status'
        ])
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() > 0
        && !request.resource.data.roomId.matches('.*[/].*')
        && request.resource.data.action in ['retryCleanup', 'approveCleanup', 'release']
        && request.resource.data.requestedAt == request.time
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'queued'
        && exists(/databases/$(database)/documents/legacyRoomQuarantine/$(request.resource.data.roomId))
        && get(/databases/$(database)/documents/legacyRoomQuarantine/$(request.resource.data.roomId)).data.status == 'manualReview';
    }

    function isProtectedAdministrator(username) {
      return username is string
        && username.lower().matches('^[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*(i_love_you_h|cybercapone)[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*$');
    }

    function hasMatchingAdminReservation(profile) {
      return (
          profile.username is string
          && profile.username.lower().matches('^[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*i_love_you_h[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*$')
          && exists(/databases/$(database)/documents/usernames/i_love_you_h)
          && get(/databases/$(database)/documents/usernames/i_love_you_h).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/usernames/i_love_you_h).data.username == profile.username
        ) || (
          profile.username is string
          && profile.username.lower().matches('^[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*cybercapone[\u0009-\u000d\u0020\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*$')
          && exists(/databases/$(database)/documents/usernames/cybercapone)
          && get(/databases/$(database)/documents/usernames/cybercapone).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/usernames/cybercapone).data.username == profile.username
        );
    }

    function hasNoDeletionQueueState(profile) {
      return !profile.keys().hasAny([
        'adminDeletionRequestedAt', 'adminDeletionRequestedBy', 'adminDeletionStatus'
      ]);
    }

    function matchingDeletionQueueJob(job, targetUid) {
      return job.keys().hasOnly(['targetUid', 'requesterUid', 'requestedAt', 'status'])
        && job.targetUid == targetUid
        && job.requesterUid == request.auth.uid
        && job.requestedAt == request.time
        && job.status == 'queued';
    }

    function matchingSelfDeletionQueueJob(job, targetUid, requestedAt) {
      return job.keys().hasOnly(['targetUid', 'requesterUid', 'requestedAt', 'requestType', 'status'])
        && targetUid == request.auth.uid
        && job.targetUid == targetUid
        && job.requesterUid == targetUid
        && job.requestedAt == requestedAt
        && job.requestType == 'self'
        && job.status == 'queued';
    }

    function validDeletionQueueProfile(userId) {
      return isAdmin()
        && !isProtectedAdministrator(resource.data.username)
        && hasNoDeletionQueueState(resource.data)
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'banned', 'adminDeletionRequestedAt', 'adminDeletionRequestedBy', 'adminDeletionStatus'
        ])
        && request.resource.data.banned == true
        && request.resource.data.adminDeletionRequestedAt == request.time
        && request.resource.data.adminDeletionRequestedBy == request.auth.uid
        && request.resource.data.adminDeletionStatus == 'queued'
        && existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(userId))
        && matchingDeletionQueueJob(
          getAfter(/databases/$(database)/documents/adminDeletionJobs/$(userId)).data,
          userId
        );
    }

    function validStandaloneAdminBan(userId) {
      return isAdmin()
        && !isProtectedAdministrator(resource.data.username)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned'])
        && request.resource.data.banned is bool
        && (request.resource.data.banned == true
          || (hasNoDeletionQueueState(resource.data)
            && !exists(/databases/$(database)/documents/adminDeletionJobs/$(userId))));
    }

    function activeUser() {
      return signedIn()
        && accountAvailable(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true;
    }

    function activePushUser() {
      return activeUser()
        && !exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function activePushUserAfter() {
      return activeUserAfter()
        && !existsAfter(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function selfDeletingPushUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function pushReadDeleteUser() {
      return activePushUser() || selfDeletingPushUser();
    }

    function validPushSubscriptionId(subscriptionId) {
      return subscriptionId.matches('^[0-9a-f]{64}$');
    }

    function validPushSubscription() {
      return request.resource.data.keys().hasOnly([
          'uid', 'endpoint', 'expirationTime', 'p256dh', 'auth', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.matches('^https://.*$')
        && request.resource.data.endpoint.size() <= 2048
        && (request.resource.data.expirationTime == null
          || (request.resource.data.expirationTime is int
            && request.resource.data.expirationTime >= 0))
        && request.resource.data.p256dh is string
        && request.resource.data.p256dh.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.p256dh.size() <= 128
        && request.resource.data.auth is string
        && request.resource.data.auth.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.auth.size() <= 64;
    }

    function currentUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function validOriginalPost() {
      return request.resource.data.keys().hasOnly(['type', 'authorId', 'username', 'content', 'imageData', 'category', 'options', 'expiresAt', 'moderationState', 'createdAt'])
        && request.resource.data.type == 'original'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 500
        && (request.resource.data.content.size() >= 1
          || request.resource.data.get('imageData', '').size() > 0)
        && request.resource.data.get('imageData', '').size() <= 800000
        && request.resource.data.get('category', 'Post') in ['Post', 'Question', 'Confession', 'Advice', 'Rant', 'Good News', 'Poll']
        && request.resource.data.get('options', []) is list
        && request.resource.data.get('options', []).size() <= 4
        && (request.resource.data.get('category', 'Post') != 'Poll'
          || request.resource.data.get('options', []).size() >= 2)
        && (request.resource.data.get('expiresAt', null) == null
          || (request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time))
        && request.resource.data.moderationState == 'visible'
        && request.resource.data.createdAt == request.time;
    }

    function validRepost(postId) {
      let original = getAfter(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId));
      return request.resource.data.keys().hasOnly([
          'type', 'authorId', 'username', 'sourceCollection', 'originalPostId',
          'originalAuthorId', 'originalUsername', 'content', 'imageData', 'moderationState', 'createdAt'
        ])
        && request.resource.data.type == 'repost'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.sourceCollection == 'posts'
        && postId == 'repost_' + request.auth.uid + '_' + request.resource.data.originalPostId
        && original.data.type == 'original'
        && original.data.get('moderationState', 'visible') != 'hidden'
        && request.resource.data.originalAuthorId == original.data.authorId
        && request.resource.data.originalUsername == original.data.username
        && accountAvailableAfter(original.data.authorId)
        && request.resource.data.content == original.data.content
        && request.resource.data.get('imageData', '') == original.data.get('imageData', '')
        && request.resource.data.moderationState == 'visible'
        && request.resource.data.createdAt == request.time;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system/accountStats {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'limit', 'updatedAt'])
        && request.resource.data.limit == 500
        && request.resource.data.updatedAt == request.time
        && ((activeUserAfter() && request.resource.data.count == 5)
          || (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(request.auth.uid))
            && request.resource.data.count == 6));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'limit', 'updatedAt'])
        && request.resource.data.limit == 500
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= request.resource.data.limit
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(request.auth.uid)))
          ||
          (request.resource.data.count == resource.data.count - 1
            && request.resource.data.count >= 0
            && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)))
        );
      allow delete: if false;
    }

    match /system/deletionProcessor {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /system/notificationProcessor {
      allow read, create, update, delete: if false;
    }

    match /system/moderationProcessor {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /reportIntakes/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if activeUserAfter()
        && validReportIntake(reportId)
        && exactReceiptAfterIntake();
      allow update, delete: if false;
    }

    match /reportReceipts/{reporterUid}/{targetKind}/{targetId} {
      allow get: if signedIn()
        && reporterUid == request.auth.uid
        && targetKind in ['post', 'communityPost', 'room', 'roomMessage', 'user']
        && reportReceiptTargetExists(targetKind, targetId);
      allow list: if false;
      allow create: if activeUserAfter()
        && reporterUid == request.auth.uid
        && targetKind in ['post', 'communityPost', 'room', 'roomMessage', 'user']
        && request.resource.data.keys().hasOnly(['reporterUid', 'targetKind', 'targetId', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetKind == targetKind
        && request.resource.data.targetId == targetId
        && request.resource.data.createdAt == request.time
        && exactIntakeAfterReceipt(reporterUid, targetKind, targetId);
      allow update, delete: if false;
    }

    match /moderationCases/{caseId} {
      allow read: if isAdmin();
      allow create: if validImmediateReportCase(caseId) || validAdminDeletionCase(caseId);
      allow update: if validImmediateReportCase(caseId)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'resolvedAt', 'resolvedBy'])
          && request.resource.data.status in ['restored', 'deleted']
          && request.resource.data.updatedAt == request.time
          && request.resource.data.resolvedAt == request.time
          && request.resource.data.resolvedBy == request.auth.uid);
      allow delete: if false;

      match /reports/{reportId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }

      match /evidence/{evidenceId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /moderationActions/{caseId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validQueuedModerationAction(caseId);
      allow update: if isAdmin() && validTerminalModerationActionRetry(caseId);
      allow delete: if false;
    }

    match /legacyRoomQuarantine/{roomId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /legacyRoomActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validLegacyRoomAction();
      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if isAdmin() || (signedIn()
        && (resource.data.blockerUid == request.auth.uid
          || resource.data.blockedUid == request.auth.uid));
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt'])
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && accountAvailableAfter(request.resource.data.blockedUid)
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
    }

    match /pageViews/{day} {
      allow read: if isAdmin();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['date', 'views', 'updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.views == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['date', 'views', 'updatedAt'])
        && request.resource.data.date == resource.data.date
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /usernames/{normalizedUsername} {
      allow read: if signedIn();
      allow create: if signedIn()
        && accountAvailableAfter(request.auth.uid)
        && !exists(/databases/$(database)/documents/usernames/$(normalizedUsername))
        && !isProtectedAdministrator(normalizedUsername)
        && !isProtectedAdministrator(request.resource.data.username)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
        && request.resource.data.username.lower() == normalizedUsername
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          == request.resource.data.username
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if activeUser()
        && resource.data.uid == request.auth.uid
        && (
          (exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
            && resource.data.username.lower() == normalizedUsername)
          ||
          (getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower()
            != normalizedUsername)
        );
    }

    match /pushSubscriptions/{subscriptionId} {
      allow get, list: if pushReadDeleteUser()
        && resource.data.uid == request.auth.uid;
      allow create: if activePushUserAfter()
        && validPushSubscriptionId(subscriptionId)
        && validPushSubscription()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if activePushUserAfter()
        && validPushSubscriptionId(subscriptionId)
        && resource.data.uid == request.auth.uid
        && validPushSubscription()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.endpoint == resource.data.endpoint
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'expirationTime', 'p256dh', 'auth', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if pushReadDeleteUser()
        && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && accountAvailableAfter(userId)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt', 'lastActiveAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
        && !isProtectedAdministrator(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActiveAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.username
          == request.resource.data.username
        && ((exists(/databases/$(database)/documents/system/accountStats)
          && getAfter(/databases/$(database)/documents/system/accountStats).data.count
            == get(/databases/$(database)/documents/system/accountStats).data.count + 1)
          || (!exists(/databases/$(database)/documents/system/accountStats)
            && getAfter(/databases/$(database)/documents/system/accountStats).data.count == 6));
      allow update: if validStandaloneAdminBan(userId)
        || validDeletionQueueProfile(userId)
        || (activeUserAfter()
          && request.auth.uid == userId
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
              && request.resource.data.lastActiveAt == request.time
              && (!resource.data.keys().hasAny(['lastActiveAt'])
                || (resource.data.lastActiveAt is timestamp
                  && request.time - resource.data.lastActiveAt >= duration.value(24, 'h'))))
            ||
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['profileImage', 'coverImage'])
              && request.resource.data.get('profileImage', '').size() <= 360000
              && request.resource.data.get('coverImage', '').size() <= 360000)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
              && (!isProtectedAdministrator(resource.data.username)
                || request.resource.data.username.lower() == resource.data.username.lower())
              && request.resource.data.username is string
              && request.resource.data.username.matches('^[A-Za-z0-9_]{3,30}$')
              && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()))
              && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid
                == request.auth.uid)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spotifyTrackUrl'])
              && request.resource.data.get('spotifyTrackUrl', '') is string
              && request.resource.data.get('spotifyTrackUrl', '').size() <= 200
              && (request.resource.data.get('spotifyTrackUrl', '') == ''
                || request.resource.data.get('spotifyTrackUrl', '')
                  .matches('https://open[.]spotify[.]com/track/[A-Za-z0-9]{22}')))
          ));
      allow delete: if activeUser()
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid))
          && !isProtectedAdministrator(resource.data.username);
    }

    match /adminDeletionJobs/{targetUid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == targetUid && resource.data.get('requestType', '') == 'self');
      allow create: if (isAdmin()
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && !isProtectedAdministrator(
          get(/databases/$(database)/documents/users/$(targetUid)).data.username
        )
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(targetUid))
        && matchingDeletionQueueJob(request.resource.data, targetUid)
        && existsAfter(/databases/$(database)/documents/users/$(targetUid))
        && hasNoDeletionQueueState(
          get(/databases/$(database)/documents/users/$(targetUid)).data
        )
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data
          .diff(get(/databases/$(database)/documents/users/$(targetUid)).data)
          .affectedKeys().hasOnly([
            'banned', 'adminDeletionRequestedAt', 'adminDeletionRequestedBy', 'adminDeletionStatus'
          ])
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.banned == true
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.adminDeletionRequestedAt
          == request.time
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.adminDeletionRequestedBy
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(targetUid)).data.adminDeletionStatus
          == 'queued')
        || (signedIn()
          && request.auth.uid == targetUid
          && exists(/databases/$(database)/documents/users/$(targetUid))
          && !isProtectedAdministrator(get(/databases/$(database)/documents/users/$(targetUid)).data.username)
          && !exists(/databases/$(database)/documents/adminDeletionJobs/$(targetUid))
          && existsAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid))
          && getAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid)).data.keys()
            .hasOnly(['uid', 'username', 'createdAt'])
          && getAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid)).data.uid == targetUid
          && getAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid)).data.username
            == get(/databases/$(database)/documents/users/$(targetUid)).data.username
          && getAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid)).data.createdAt is timestamp
          && matchingSelfDeletionQueueJob(
            request.resource.data,
            targetUid,
            getAfter(/databases/$(database)/documents/accountDeletionRequests/$(targetUid)).data.createdAt
          ));
      allow update, delete: if false;
    }

    match /accountDeletionRequests/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if activeUser()
        && request.auth.uid == userId
        && !isProtectedAdministrator(currentUsername())
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/adminDeletionJobs/$(userId))
        && matchingSelfDeletionQueueJob(
          getAfter(/databases/$(database)/documents/adminDeletionJobs/$(userId)).data,
          userId,
          request.time
        );
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/adminDeletionJobs/$(userId));
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && accountAvailableAfter(request.resource.data.followingId)
        && !pairIsBlocked(request.auth.uid, request.resource.data.followingId)
        && followId == request.auth.uid + '_' + request.resource.data.followingId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
    }

    match /notificationReads/{readId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if activeUserAfter()
        && readId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'readAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.eventId.matches('^event-[0-9a-f]{16}$')
        && request.resource.data.readAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /notificationEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, create, update, delete: if false;
    }

    match /{documentPath=**}/comments/{commentId} {
      allow read: if signedIn() && visibleContentOrAdmin(documentPath);
      allow create: if activeUserAfter()
        && contentAvailableAfter(documentPath)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    match /{documentPath=**}/reactions/{reactionId} {
      allow read: if signedIn() && visibleContentOrAdmin(documentPath);
      allow create: if activeUserAfter()
        && contentAvailableAfter(documentPath)
        && reactionId == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['heart', 'middle_finger', 'laugh', 'sad']
        && request.resource.data.createdAt == request.time;
      allow update: if activeUserAfter()
        && contentAvailableAfter(documentPath)
        && reactionId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['heart', 'middle_finger', 'laugh', 'sad']
        && request.resource.data.createdAt == request.time;
      allow delete: if (signedIn()
          && reactionId == request.auth.uid
          && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    function acceptedConversationMessage(requestId, message) {
      let conversation = get(/databases/$(database)/documents/messageRequests/$(requestId));
      return exists(/databases/$(database)/documents/messageRequests/$(requestId))
        && conversation.data.status == 'accepted'
        && (requestId == conversation.data.fromId + '_' + conversation.data.toId
          || requestId == conversation.data.toId + '_' + conversation.data.fromId)
        && (conversation.data.fromId == request.auth.uid
          || conversation.data.toId == request.auth.uid)
        && !pairIsBlocked(conversation.data.fromId, conversation.data.toId)
        && message.participants is list
        && message.participants.size() == 2
        && conversation.data.fromId in message.participants
        && conversation.data.toId in message.participants
        && message.senderId in message.participants;
    }

    function acceptedConversationMessageAfter(requestId, message) {
      let conversation = getAfter(/databases/$(database)/documents/messageRequests/$(requestId));
      return existsAfter(/databases/$(database)/documents/messageRequests/$(requestId))
        && conversation.data.status == 'accepted'
        && (requestId == conversation.data.fromId + '_' + conversation.data.toId
          || requestId == conversation.data.toId + '_' + conversation.data.fromId)
        && (conversation.data.fromId == request.auth.uid
          || conversation.data.toId == request.auth.uid)
        && !pairIsBlocked(conversation.data.fromId, conversation.data.toId)
        && message.participants is list
        && message.participants.size() == 2
        && conversation.data.fromId in message.participants
        && conversation.data.toId in message.participants
        && message.senderId == request.auth.uid;
    }

    function acceptedChat(otherId) {
      return !pairIsBlocked(request.auth.uid, otherId)
        && ((exists(/databases/$(database)/documents/messageRequests/$(request.auth.uid + '_' + otherId))
          && get(/databases/$(database)/documents/messageRequests/$(request.auth.uid + '_' + otherId)).data.status == 'accepted')
        || (exists(/databases/$(database)/documents/messageRequests/$(otherId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/messageRequests/$(otherId + '_' + request.auth.uid)).data.status == 'accepted'));
    }

    function mutualReveal(otherId) {
      return !pairIsBlocked(request.auth.uid, otherId)
        && exists(/databases/$(database)/documents/reveals/$(request.auth.uid + '_' + otherId))
        && exists(/databases/$(database)/documents/reveals/$(otherId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/reveals/$(request.auth.uid + '_' + otherId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/reveals/$(otherId + '_' + request.auth.uid)).data.status == 'accepted';
    }

    match /userPrivate/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || mutualReveal(userId));
      allow create, update: if activeUserAfter()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'interests', 'region', 'ageRange', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.interests is string
        && request.resource.data.interests.size() <= 100
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 60
        && request.resource.data.ageRange is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /userPreferences/{userId} {
      allow read: if activeUser() && request.auth.uid == userId;
      allow create, update: if activeUserAfter() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'mutedKeywords', 'contextCheck', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mutedKeywords is list
        && request.resource.data.mutedKeywords.size() <= 20
        && request.resource.data.contextCheck is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /circles/{circleId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 180
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (activeUser() && resource.data.ownerId == request.auth.uid);
    }

    match /circleMembers/{memberId} {
      allow read: if signedIn();
      allow create: if activeUserAfter()
        && memberId == request.resource.data.circleId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['circleId', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && circleAvailableAfter(request.resource.data.circleId)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityPosts/{postId} {
      allow read: if signedIn() && visibleOrAdmin();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['authorId', 'username', 'content', 'category', 'circleId', 'options', 'expiresAt', 'moderationState', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.username == currentUsername()
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 500
        && request.resource.data.category in ['Question', 'Confession', 'Advice', 'Rant', 'Good News', 'Poll']
        && request.resource.data.circleId is string
        && circleAvailableAfter(request.resource.data.circleId)
        && request.resource.data.options is list
        && request.resource.data.options.size() <= 4
        && request.resource.data.moderationState == 'visible'
        && request.resource.data.createdAt == request.time;
      allow update: if validModerationHoldUpdate('communityPost', postId, resource.data.authorId)
        || validAdminMaterialRestore();
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /communityVotes/{voteId} {
      allow read: if signedIn() && communityVoteVisibleOrAdmin();
      allow create, update: if activeUserAfter()
        && votePostAvailableAfter(request.resource.data.postCollection, request.resource.data.postId)
        && voteId == request.resource.data.postCollection + ':' + request.resource.data.postId + ':' + request.auth.uid
        && request.resource.data.keys().hasOnly(['postCollection', 'postId', 'uid', 'option', 'createdAt'])
        && request.resource.data.postCollection in ['posts', 'communityPosts']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.option is int
        && request.resource.data.option >= 0
        && request.resource.data.option <= 3
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && visibleOrAdmin();
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['name', 'topic', 'ownerId', 'createdAt', 'expiresAt', 'moderationState'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.moderationState == 'visible'
        && validRoomExpiry();
      allow update: if validModerationHoldUpdate('room', roomId, resource.data.ownerId)
        || (activeUserAfter()
          && resource.data.ownerId == request.auth.uid
          && resource.data.get('moderationState', 'visible') == 'visible'
          && resource.data.get('cleanupState', 'open') != 'closing'
          && request.resource.data.get('cleanupState', '') == 'closing'
          && request.resource.data.closedAt == request.time
          && request.resource.data.expiresAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cleanupState', 'closedAt', 'expiresAt']));
      allow delete: if false;
    }

    match /roomMembers/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if activeUserAfter()
        && memberId == request.resource.data.roomId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['roomId', 'uid', 'joinedAt'])
        && request.resource.data.uid == request.auth.uid
        && roomAvailableAfter(request.resource.data.roomId)
        && !pairIsBlocked(request.auth.uid,
          getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerId)
        && request.resource.data.joinedAt == request.time;
      allow update: if activeUserAfter()
        && roomAvailableAfter(request.resource.data.roomId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedAt'])
        && !pairIsBlocked(request.auth.uid,
          getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerId)
        && request.resource.data.joinedAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /roomMessages/{messageId} {
      allow read: if isAdmin() || (signedIn()
        && resource.data.get('moderationState', 'visible') != 'hidden'
        && linkedRoomAvailable(resource.data.roomId));
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['roomId', 'senderId', 'tempName', 'text', 'expiresAt', 'moderationState', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && roomAvailableAfter(request.resource.data.roomId)
        && !pairIsBlocked(request.auth.uid,
          getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerId)
        && request.resource.data.tempName is string
        && request.resource.data.tempName.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280
        && request.resource.data.moderationState == 'visible'
        && validRoomMessageExpiry(request.resource.data.roomId)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn()
        && resource.data.senderId == request.auth.uid
        && linkedRoomAvailable(resource.data.roomId));
    }

    match /messageRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if activeUserAfter()
        && accountAvailableAfter(request.resource.data.toId)
        && request.resource.data.keys().hasOnly(['fromId', 'toId', 'status', 'createdAt'])
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId != request.auth.uid
        && !pairIsBlocked(request.auth.uid, request.resource.data.toId)
        && request.resource.data.status == 'pending'
        && (requestId == request.resource.data.fromId + '_' + request.resource.data.toId
          || requestId == request.resource.data.toId + '_' + request.resource.data.fromId)
        && request.resource.data.createdAt == request.time;
      allow update: if activeUserAfter()
        && accountAvailableAfter(request.resource.data.fromId)
        && accountAvailableAfter(request.resource.data.toId)
        && !pairIsBlocked(request.resource.data.fromId, request.resource.data.toId)
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
            && resource.data.toId == request.auth.uid
            && request.resource.data.status in ['accepted', 'declined'])
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
            && resource.data.fromId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.status == 'pending')
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fromId', 'toId', 'status', 'createdAt'])
            && resource.data.status == 'declined'
            && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid)
            && request.resource.data.fromId == request.auth.uid
            && request.resource.data.toId == (resource.data.fromId == request.auth.uid
              ? resource.data.toId : resource.data.fromId)
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time)
        )
        && (!request.resource.data.keys().hasAny(['respondedAt'])
          || request.resource.data.respondedAt == resource.data.get('respondedAt', null)
          || request.resource.data.respondedAt == request.time);
      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /messageRequests/{requestId}/messages/{messageId} {
      allow read: if activeUser()
        && acceptedConversationMessage(requestId, resource.data);
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly([
          'participants', 'senderId', 'text', 'createdAt', 'expiresAt'
        ])
        && acceptedConversationMessageAfter(requestId, request.resource.data)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['expiresAt'])
          || (request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt >= request.time + duration.value(23, 'h')
              + duration.value(55, 'm')
            && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')
              + duration.value(5, 'm')));
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid in resource.data.participants;
    }

    match /directMessages/{messageId} {
      allow read: if activeUser()
        && resource.data.participants is list
        && resource.data.participants.size() == 2
        && resource.data.participants[0] != resource.data.participants[1]
        && resource.data.senderId in resource.data.participants
        && request.auth.uid in resource.data.participants
        && acceptedChat(resource.data.participants[0] == request.auth.uid
          ? resource.data.participants[1] : resource.data.participants[0]);
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['participants', 'senderId', 'text', 'createdAt', 'expiresAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && accountAvailableAfter(request.resource.data.participants[0])
        && accountAvailableAfter(request.resource.data.participants[1])
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.senderId == request.auth.uid
        && !pairIsBlocked(request.resource.data.participants[0], request.resource.data.participants[1])
        && acceptedChat(request.resource.data.participants[0] == request.auth.uid
          ? request.resource.data.participants[1] : request.resource.data.participants[0])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['expiresAt'])
          || (request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt >= request.time + duration.value(23, 'h')
              + duration.value(55, 'm')
            && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')
              + duration.value(5, 'm')));
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /reveals/{revealId} {
      allow read: if activeUser()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if activeUserAfter()
        && request.resource.data.keys().hasOnly(['fromId', 'toId', 'fields', 'status', 'createdAt'])
        && request.resource.data.fromId == request.auth.uid
        && accountAvailableAfter(request.resource.data.toId)
        && !pairIsBlocked(request.auth.uid, request.resource.data.toId)
        && acceptedChat(request.resource.data.toId)
        && request.resource.data.fields.keys().hasOnly(['interests', 'region', 'ageRange'])
        && request.resource.data.status == 'pending'
        && revealId == request.auth.uid + '_' + request.resource.data.toId
        && request.resource.data.createdAt == request.time;
      allow update: if activeUserAfter()
        && accountAvailableAfter(resource.data.fromId)
        && accountAvailableAfter(resource.data.toId)
        && !pairIsBlocked(resource.data.fromId, resource.data.toId)
        && resource.data.toId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.respondedAt == request.time;
      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /posts/{postId}/comments/{commentId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    match /communityPosts/{postId}/comments/{commentId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId == request.auth.uid;
    }

    match /posts/{postId}/reactions/{reactionId} {
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if signedIn() && visibleOrAdmin();
      allow create: if activeUserAfter() && (validOriginalPost() || validRepost(postId));
      allow update: if validModerationHoldUpdate('post', postId, resource.data.authorId)
        || validAdminMaterialRestore();
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }
  }
}
