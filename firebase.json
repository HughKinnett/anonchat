{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "README.md",
      "package.json",
      "package-lock.json",
      "scripts/**",
      "docs/**",
      ".git/**",
      ".github/**",
      ".worktrees/**",
      ".superpowers/**",
      ".npm-cache/**",
      ".firebase/**",
      "node_modules/**",
      "**/node_modules/**",
      "*.md",
      "gha-creds-*.json",
      "**/gha-creds-*.json",
      "**/service-account*.json",
      "**/serviceAccount*.json",
      "**/*.pem",
      "**/*.key"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "**/*.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "**/*.mjs",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "**/*.css",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "**/*.webmanifest",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      }
    ]
  }
}
